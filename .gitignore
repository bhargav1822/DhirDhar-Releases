# =============================================================================
# DhirDhar Release Repository (.gitignore)
# Policy: RELEASES ONLY - NO SOURCE CODE, NO PROJECT FILES, NO BUILD ARTIFACTS
# =============================================================================

# Prevent Source Code and Solution Directories
DhirDhar Solution/
src/
tests/
scripts/
tools/
packages/
Packages/
icons/

# Build Outputs and Intermediate Files
[Bb]in/
[Oo]bj/
Release/
Release_Obfuscated/
Publish/
Installer/
TestResults/
artifacts/

# .NET / C# / XAML Source and Project Files
*.cs
*.xaml
*.csproj
*.sln
*.slnx
*.props
*.targets
*.iss
*.manifest
*.resw
*.resx
*.pri

# User-specific files & IDE configuration
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs

# Database, Backups, and User Data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak

# Logs, Diagnostics, and Temporary Files
*.log
*.tmp
*.temp
*.binlog
*.trx
*.txt
*.backup
update.log

# Certificates, Secrets, and Credentials
*.pfx
*.p12
*.key
*.pem
*.cer
*.crt
*client_secrets.json
app_integrity.sig

# Node / Scratch scripts
node_modules/
package.json
package-lock.json
*.py

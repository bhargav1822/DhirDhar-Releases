<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:DhirDhar.Desktop.Helpers">

    <!-- Dedicated Gujarati Font Resource - Unicode: Noto Sans Gujarati -->
    <FontFamily x:Key="GujaratiFontFamily">Noto Sans Gujarati, ms-appx:///Assets/Fonts/NotoSansGujarati.ttf#Noto Sans Gujarati, ms-appx:///Assets/NotoSansGujarati.ttf#Noto Sans Gujarati, Segoe UI, Nirmala UI</FontFamily>

    <!-- Hindi Font Resource - Unicode: Noto Sans Devanagari -->
    <FontFamily x:Key="HindiFontFamily">Noto Sans Devanagari, ms-appx:///Assets/Fonts/NotoSansDevanagari.ttf#Noto Sans Devanagari, Segoe UI, Nirmala UI</FontFamily>

    <!-- Global Application Font Resource (Noto Sans Gujarati -> Noto Sans Devanagari -> Segoe UI -> Nirmala UI) - Unicode only, no legacy fonts -->
    <FontFamily x:Key="AppFontFamily">Noto Sans Gujarati, ms-appx:///Assets/Fonts/NotoSansGujarati.ttf#Noto Sans Gujarati, Noto Sans Devanagari, ms-appx:///Assets/Fonts/NotoSansDevanagari.ttf#Noto Sans Devanagari, ms-appx:///Assets/NotoSansGujarati.ttf#Noto Sans Gujarati, Segoe UI, Nirmala UI</FontFamily>

    <!-- WinUI Theme Font Family Overrides - Unicode only -->
    <FontFamily x:Key="ContentControlThemeFontFamily">Noto Sans Gujarati, ms-appx:///Assets/Fonts/NotoSansGujarati.ttf#Noto Sans Gujarati, Noto Sans Devanagari, ms-appx:///Assets/Fonts/NotoSansDevanagari.ttf#Noto Sans Devanagari, ms-appx:///Assets/NotoSansGujarati.ttf#Noto Sans Gujarati, Segoe UI, Nirmala UI</FontFamily>
    <FontFamily x:Key="ControlContentThemeFontFamily">Noto Sans Gujarati, ms-appx:///Assets/Fonts/NotoSansGujarati.ttf#Noto Sans Gujarati, Noto Sans Devanagari, ms-appx:///Assets/Fonts/NotoSansDevanagari.ttf#Noto Sans Devanagari, ms-appx:///Assets/NotoSansGujarati.ttf#Noto Sans Gujarati, Segoe UI, Nirmala UI</FontFamily>
    <FontFamily x:Key="TextControlThemeFontFamily">Noto Sans Gujarati, ms-appx:///Assets/Fonts/NotoSansGujarati.ttf#Noto Sans Gujarati, Noto Sans Devanagari, ms-appx:///Assets/Fonts/NotoSansDevanagari.ttf#Noto Sans Devanagari, ms-appx:///Assets/NotoSansGujarati.ttf#Noto Sans Gujarati, Segoe UI, Nirmala UI</FontFamily>
    <FontFamily x:Key="ComboBoxThemeFontFamily">Noto Sans Gujarati, ms-appx:///Assets/Fonts/NotoSansGujarati.ttf#Noto Sans Gujarati, Noto Sans Devanagari, ms-appx:///Assets/Fonts/NotoSansDevanagari.ttf#Noto Sans Devanagari, ms-appx:///Assets/NotoSansGujarati.ttf#Noto Sans Gujarati, Segoe UI, Nirmala UI</FontFamily>
    <FontFamily x:Key="ButtonThemeFontFamily">Noto Sans Gujarati, ms-appx:///Assets/Fonts/NotoSansGujarati.ttf#Noto Sans Gujarati, Noto Sans Devanagari, ms-appx:///Assets/Fonts/NotoSansDevanagari.ttf#Noto Sans Devanagari, ms-appx:///Assets/NotoSansGujarati.ttf#Noto Sans Gujarati, Segoe UI, Nirmala UI</FontFamily>

    <!-- Implicit Control Styles to enforce AppFontFamily globally across all controls -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="helpers:IndicInput.IsEnabled" Value="True" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="helpers:IndicInput.IsEnabled" Value="True" />
    </Style>

    <Style TargetType="AutoSuggestBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="helpers:IndicInput.IsEnabled" Value="True" />
    </Style>

    <Style TargetType="NumberBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="helpers:IndicInput.IsDisabled" Value="True" />
    </Style>

    <Style TargetType="RichEditBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>

    <Style TargetType="ListViewItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>

    <Style TargetType="GridViewItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    </Style>

    <x:Double x:Key="FontSizeSmall">12</x:Double>
    <x:Double x:Key="FontSizeMedium">14</x:Double>
    <x:Double x:Key="FontSizeLarge">16</x:Double>
    <x:Double x:Key="FontSizeTitle">20</x:Double>
    <x:Double x:Key="FontSizeHeading">24</x:Double>
    <x:Double x:Key="FontSizeDisplay">32</x:Double>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="HeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeMedium}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="SubtleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
        <Setter Property="Foreground" Value="{ThemeResource SubtleForegroundBrush}" />
    </Style>

</ResourceDictionary>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ApplicationForegroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#F5F5F5" />
            <SolidColorBrush x:Key="SurfaceForegroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#1A73E8" />
            <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="#E8EAED" />
            <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#34A853" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FBBC04" />
            <Color x:Key="ErrorColor">#EA4335</Color>
            <SolidColorBrush x:Key="ErrorBrush" Color="#EA4335" />
            <SolidColorBrush x:Key="BorderBrush" Color="#DADCE0" />
            <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#5F6368" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#DADCE0" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#F8F9FA" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#E8EAED" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#EA4335" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FCE8E6" />

            <!-- Global Financial Color System Brushes (Light Theme) -->
            <SolidColorBrush x:Key="PrincipalBrush" Color="#34A853" />
            <SolidColorBrush x:Key="InterestBrush" Color="#1A73E8" />
            <SolidColorBrush x:Key="DepositBrush" Color="#34A853" />
            <SolidColorBrush x:Key="WithdrawalBrush" Color="#EA4335" />

            <!-- Action Button Semantic Color Brushes (Light Theme) -->
            <SolidColorBrush x:Key="EditActionForegroundBrush" Color="#1A73E8" />
            <SolidColorBrush x:Key="EditActionBorderBrush" Color="#AECBFA" />
            <SolidColorBrush x:Key="EditActionBackgroundBrush" Color="#F1F5FE" />

            <SolidColorBrush x:Key="ReceiveActionForegroundBrush" Color="#137333" />
            <SolidColorBrush x:Key="ReceiveActionBorderBrush" Color="#A8DAB5" />
            <SolidColorBrush x:Key="ReceiveActionBackgroundBrush" Color="#E6F4EA" />

            <SolidColorBrush x:Key="GiveActionForegroundBrush" Color="#B06000" />
            <SolidColorBrush x:Key="GiveActionBorderBrush" Color="#FDE293" />
            <SolidColorBrush x:Key="GiveActionBackgroundBrush" Color="#FEF7E0" />

            <SolidColorBrush x:Key="CloseActionForegroundBrush" Color="#C5221F" />
            <SolidColorBrush x:Key="CloseActionBorderBrush" Color="#FAD2CF" />
            <SolidColorBrush x:Key="CloseActionBackgroundBrush" Color="#FCE8E6" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="ApplicationForegroundBrush" Color="#E8EAED" />
            <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#292A2D" />
            <SolidColorBrush x:Key="SurfaceCardBrush" Color="#292A2D" />
            <SolidColorBrush x:Key="SurfaceForegroundBrush" Color="#E8EAED" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#8AB4F8" />
            <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="SecondaryBrush" Color="#3C4043" />
            <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="#E8EAED" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#81C995" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FDD663" />
            <Color x:Key="ErrorColor">#F28B82</Color>
            <SolidColorBrush x:Key="ErrorBrush" Color="#F28B82" />
            <SolidColorBrush x:Key="BorderBrush" Color="#5F6368" />
            <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#9AA0A6" />
            <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#5F6368" />
            <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#292A2D" />
            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#3C4043" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#F28B82" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#331D1C" />

            <!-- Global Financial Color System Brushes (Dark Theme) -->
            <SolidColorBrush x:Key="PrincipalBrush" Color="#81C995" />
            <SolidColorBrush x:Key="InterestBrush" Color="#8AB4F8" />
            <SolidColorBrush x:Key="DepositBrush" Color="#81C995" />
            <SolidColorBrush x:Key="WithdrawalBrush" Color="#F28B82" />

            <!-- Action Button Semantic Color Brushes (Dark Theme) -->
            <SolidColorBrush x:Key="EditActionForegroundBrush" Color="#8AB4F8" />
            <SolidColorBrush x:Key="EditActionBorderBrush" Color="#3C485E" />
            <SolidColorBrush x:Key="EditActionBackgroundBrush" Color="#1E2A38" />

            <SolidColorBrush x:Key="ReceiveActionForegroundBrush" Color="#81C995" />
            <SolidColorBrush x:Key="ReceiveActionBorderBrush" Color="#274A33" />
            <SolidColorBrush x:Key="ReceiveActionBackgroundBrush" Color="#1B3323" />

            <SolidColorBrush x:Key="GiveActionForegroundBrush" Color="#FDD663" />
            <SolidColorBrush x:Key="GiveActionBorderBrush" Color="#4A3F1F" />
            <SolidColorBrush x:Key="GiveActionBackgroundBrush" Color="#332D19" />

            <SolidColorBrush x:Key="CloseActionForegroundBrush" Color="#F28B82" />
            <SolidColorBrush x:Key="CloseActionBorderBrush" Color="#4D2726" />
            <SolidColorBrush x:Key="CloseActionBackgroundBrush" Color="#331D1C" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

</ResourceDictionary>

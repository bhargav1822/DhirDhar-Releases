<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Name="BorrowersPageRoot"
    x:Class="DhirDhar.Desktop.Views.Borrowers.BorrowersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DhirDhar.Desktop.Converters"
    xmlns:models="using:DhirDhar.Application.Borrowers.Models"
    xmlns:helpers="using:DhirDhar.Desktop.Helpers"
    xmlns:controls="using:DhirDhar.Desktop.Controls"
    Background="{ThemeResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:StatusToLocalizedTextConverter x:Key="StatusToLocalizedTextConverter" />
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
        <converters:DigitLocalizingConverter x:Key="DigitLocalizingConverter" />

        <Style x:Key="BorrowerListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="52" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="30,24,30,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Page Header: Title, Subtitle, Scan QR, Refresh, Add Borrower -->
                <Grid Grid.Row="0" MinHeight="60" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" FontSize="31" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource SubtleForegroundBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" MinWidth="110" Height="48" Padding="14,0" CornerRadius="8" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.ScanQrCommand, Mode=OneWay}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xED14;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.ScanQrText, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" MinWidth="110" Height="48" Padding="14,0" CornerRadius="8" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE72C;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.RefreshText, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="3" MinWidth="140" Height="48" Padding="16,0" CornerRadius="8" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.AddBorrowerCommand, Mode=OneWay}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE710;" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.AddBorrowerText, Mode=OneWay}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Search Area: Flexible width up to 720px -->
                <Border Grid.Row="1" Height="62" HorizontalAlignment="Left" MinWidth="320" MaxWidth="720" Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="12" Padding="18,6" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" Margin="0,0,0,18">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" Glyph="&#xE721;" FontSize="18" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <controls:DhirDharPhoneticTextBox FieldType="SearchText" Grid.Column="1" HorizontalAlignment="Stretch" Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}" KeyDown="SearchTextBox_KeyDown" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" />
                        <Button Grid.Column="2" MinWidth="95" Height="44" Padding="14,0" CornerRadius="8" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.SearchCommand, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.SearchText, Mode=OneWay}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Filter Buttons: 18px below search area -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" Margin="0,0,0,26">
                    <Button x:Name="AllFilterButton" MinWidth="90" Height="44" Padding="14,0" Style="{StaticResource FilterButtonStyle}" Content="{x:Bind ViewModel.AllFilterText, Mode=OneWay}" Command="{x:Bind ViewModel.FilterAllCommand, Mode=OneWay}" />
                    <Button x:Name="ActiveFilterButton" MinWidth="90" Height="44" Padding="14,0" Style="{StaticResource FilterButtonStyle}" Content="{x:Bind ViewModel.ActiveFilterText, Mode=OneWay}" Command="{x:Bind ViewModel.FilterActiveCommand, Mode=OneWay}" />
                    <Button x:Name="ClosedFilterButton" MinWidth="100" Height="44" Padding="14,0" Style="{StaticResource FilterButtonStyle}" Content="{x:Bind ViewModel.ClosedFilterText, Mode=OneWay}" Command="{x:Bind ViewModel.FilterClosedCommand, Mode=OneWay}" />
                </StackPanel>

                <!-- Loading Indicator -->
                <ProgressRing Grid.Row="3" HorizontalAlignment="Center" Margin="0,36" Style="{StaticResource LoadingIndicatorStyle}" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Error Banner -->
                <Grid Grid.Row="3" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,16">
                    <Grid.Background><SolidColorBrush Color="{ThemeResource ErrorColor}" Opacity="0.1" /></Grid.Background>
                    <Grid Padding="16" CornerRadius="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xEA39;" Foreground="{ThemeResource ErrorBrush}" FontSize="20" />
                            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{x:Bind ViewModel.RetryText, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.RetryText, Mode=OneWay}" />
                    </Grid>
                </Grid>

                <!-- Borrower Table: Width 100%, MinHeight 95px, Padding 18px -->
                <Grid Grid.Row="4" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <!-- Borrowers List Card -->
                    <Border Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="12" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" MinHeight="95" Visibility="{x:Bind ViewModel.HasItems, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Grid MinWidth="750">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Column Headers: 16%, 23%, 17%, 13%, 10%, 14%, 7% -->
                                <Grid Grid.Row="0" MinHeight="42" Padding="18,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16*" MinWidth="90" />
                                        <ColumnDefinition Width="23*" MinWidth="130" />
                                        <ColumnDefinition Width="17*" MinWidth="100" />
                                        <ColumnDefinition Width="13*" MinWidth="90" />
                                        <ColumnDefinition Width="10*" MinWidth="70" />
                                        <ColumnDefinition Width="14*" MinWidth="90" />
                                        <ColumnDefinition Width="7*" MinWidth="45" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.BorrowerNumberColumnHeader, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BorrowerNameColumnHeader, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ContactColumnHeader, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.OutstandingColumnHeader, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,28,0" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.StatusColumnHeader, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.LastActivityColumnHeader, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind ViewModel.EditText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Header Divider -->
                                <Border Grid.Row="1" Height="1" Background="{ThemeResource BorderBrush}" Margin="18,0" Opacity="0.6" />

                                <!-- Borrowers List -->
                                <ListView Grid.Row="2"
                                          ItemsSource="{x:Bind ViewModel.Borrowers, Mode=OneWay}"
                                          SelectionMode="None"
                                          IsItemClickEnabled="False"
                                          ItemContainerStyle="{StaticResource BorrowerListViewItemStyle}">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:BorrowerSummary">
                                            <Grid>
                                                <Grid Padding="18,0" MinHeight="52" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16*" MinWidth="90" />
                                                        <ColumnDefinition Width="23*" MinWidth="130" />
                                                        <ColumnDefinition Width="17*" MinWidth="100" />
                                                        <ColumnDefinition Width="13*" MinWidth="90" />
                                                        <ColumnDefinition Width="10*" MinWidth="70" />
                                                        <ColumnDefinition Width="14*" MinWidth="90" />
                                                        <ColumnDefinition Width="7*" MinWidth="45" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Interactive Button covering columns 0-5 for row selection -->
                                                    <Button Grid.Column="0" Grid.ColumnSpan="6"
                                                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                            Background="Transparent" BorderThickness="0" CornerRadius="4"
                                                            Command="{Binding DataContext.SelectBorrowerCommand, ElementName=BorrowersPageRoot}"
                                                            CommandParameter="{x:Bind Id}"
                                                            ToolTipService.ToolTip="{Binding DataContext.ViewBorrowerDetailsLabel, ElementName=BorrowersPageRoot}" />

                                                    <TextBlock Grid.Column="0" Text="{x:Bind BorrowerNumber, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />

                                                    <TextBlock Grid.Column="1" Text="{x:Bind FullName, Mode=OneTime}" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />

                                                    <TextBlock Grid.Column="2" Text="{x:Bind Contact, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="12.5" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" />

                                                    <TextBlock Grid.Column="3" FontSize="13.5" FontWeight="SemiBold" Foreground="{ThemeResource SuccessBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False" Margin="0,0,28,0">
                                                        <Run Text="₹ " /><Run Text="{x:Bind OutstandingAmount, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" />
                                                    </TextBlock>

                                                    <!-- Status Column: Text only, NO green dot, NO badge, Active = Green, Closed = Red -->
                                                    <TextBlock Grid.Column="4" Text="{x:Bind Status, Mode=OneTime, Converter={StaticResource StatusToLocalizedTextConverter}}" FontSize="12.5" FontWeight="SemiBold" Foreground="{x:Bind Status, Mode=OneTime, Converter={StaticResource StatusToBrushConverter}}" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Margin="12,0,0,0" />

                                                    <TextBlock Grid.Column="5" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
                                                        <Run Text="{x:Bind LastTransactionDate, Mode=OneTime, Converter={StaticResource DateTimeFormatConverter}, ConverterParameter=short}" />
                                                    </TextBlock>

                                                    <!-- Dedicated 7% Edit Column with Centered 20px Icon -->
                                                    <Button Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                            Style="{StaticResource IconOnlyButtonStyle}" Height="38" Width="38" CornerRadius="6"
                                                            Command="{Binding DataContext.EditBorrowerCommand, ElementName=BorrowersPageRoot}"
                                                            CommandParameter="{x:Bind Id}"
                                                            ToolTipService.ToolTip="{Binding DataContext.EditText, ElementName=BorrowersPageRoot}"
                                                            AutomationProperties.Name="{Binding DataContext.EditText, ElementName=BorrowersPageRoot}">
                                                        <FontIcon Glyph="&#xE70F;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Button>
                                                </Grid>
                                                <Border Height="1" Background="{ThemeResource BorderBrush}" Opacity="0.4" VerticalAlignment="Bottom" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Empty State: No Borrowers -->
                    <Border Background="{ThemeResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="40" Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE716;" Foreground="{ThemeResource SubtleForegroundBrush}" FontSize="32" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.NoBorrowersTitle, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.NoBorrowersDescription, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                            <Button Style="{StaticResource PrimaryButtonStyle}" Height="40" MinWidth="130" CornerRadius="8" Command="{x:Bind ViewModel.AddBorrowerCommand, Mode=OneWay}" Margin="0,6,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE710;" FontSize="16" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind ViewModel.AddBorrowerText, Mode=OneWay}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Empty State: No Search Results -->
                    <Border Background="{ThemeResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="40" Visibility="{x:Bind ViewModel.IsNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE721;" Foreground="{ThemeResource SubtleForegroundBrush}" FontSize="32" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.NoSearchResultsTitle, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.NoSearchResultsDescription, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="1" Height="44" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.ReadyText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{x:Bind ViewModel.FormattedApplicationVersion, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                    <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.FormattedFinancialYear, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.FormattedLastUpdated, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DhirDhar.Desktop.Views.Security.SecurityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DhirDhar.Desktop.Converters"
    Background="{ThemeResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource HeadingTextStyle}" />

            <Border Grid.Row="1" Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.ApplicationLockLabel, Mode=OneWay}" Style="{StaticResource TitleTextStyle}" />
                    <ToggleSwitch Header="{x:Bind ViewModel.EnableLockLabel, Mode=OneWay}" IsOn="{x:Bind ViewModel.IsLockEnabled, Mode=TwoWay}" />
                    <Button Content="{x:Bind ViewModel.EnableLockLabel, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.EnableLockCommand, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLockEnabled, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                    <Button Content="{x:Bind ViewModel.DisableLockLabel, Mode=OneWay}" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.DisableLockCommand, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsLockEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="8" Padding="20"
                    Visibility="{x:Bind ViewModel.IsLockEnabled, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.AutoLockLabel, Mode=OneWay}" Style="{StaticResource TitleTextStyle}" />
                    <ComboBox ItemsSource="{x:Bind ViewModel.AutoLockOptions, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.AutoLockSetting, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" MinWidth="150" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

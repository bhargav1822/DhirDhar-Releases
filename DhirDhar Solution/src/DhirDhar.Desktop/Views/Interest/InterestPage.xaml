<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DhirDhar.Desktop.Views.Interest.InterestPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DhirDhar.Desktop.Converters"
    xmlns:models="using:DhirDhar.Domain.Interest"
    xmlns:appModels="using:DhirDhar.Application.Borrowers.Models"
    xmlns:helpers="using:DhirDhar.Desktop.Helpers"
    Background="{ThemeResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:TextToLocalizedTextConverter x:Key="TextToLocalizedTextConverter" />
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
        <converters:LocalizedNumberConverter x:Key="LocalizedNumberConverter" />
        <converters:DigitLocalizingConverter x:Key="DigitLocalizingConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="30,24,30,24" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Page Header: Title (32px), Subtitle (16px), Refresh Button (120x44) -->
            <Grid Grid.Row="0" Margin="0,0,0,26">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" FontSize="32" FontWeight="SemiBold" />
                    <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" FontSize="16" Foreground="{ThemeResource SubtleForegroundBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Width="120" Height="44" CornerRadius="8" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.RefreshText, Mode=OneWay}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 2. Borrower Search & Calculation Date Controls Row (48px Height) -->
            <Grid Grid.Row="1" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="340" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Borrower Search Input -->
                <StackPanel Grid.Column="0" Spacing="6" HorizontalAlignment="Stretch" Margin="0,0,20,0">
                    <TextBlock Text="{x:Bind ViewModel.SearchBorrowerLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                    <AutoSuggestBox x:Name="BorrowerSearchBox"
                                    MinWidth="260" MaxWidth="640" Height="48"
                                    HorizontalAlignment="Stretch"
                                    PlaceholderText="{x:Bind ViewModel.SearchBorrowerPlaceholder, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.SearchQueryText, Mode=OneWay}"
                                    ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                                    TextMemberPath="FullName"
                                    VerticalAlignment="Center">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate x:DataType="appModels:BorrowerSummary">
                                <StackPanel Padding="4,4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind FullName, Mode=OneTime}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{x:Bind BorrowerNumber, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" Foreground="{ThemeResource PrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Contact, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="11.5" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </StackPanel>

                <!-- Calculation Date & Calculate Button (Right, 155px Date + 125px Button) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.CalculationDateLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                        <CalendarDatePicker helpers:DatePickerLocalization.IsEnabled="True"
                                            MinWidth="140" Height="48"
                                            Date="{x:Bind ViewModel.CalculationDate, Mode=TwoWay}"
                                            IsEnabled="{x:Bind ViewModel.IsCalculating, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}"
                                            VerticalAlignment="Center" />
                    </StackPanel>
                    <Button MinWidth="115" Height="48" Padding="16,0"
                            Content="{x:Bind ViewModel.CalculateLabel, Mode=OneWay}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Bind ViewModel.CalculateCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanCalculate, Mode=OneWay}"
                            VerticalAlignment="Bottom" CornerRadius="8" />
                </StackPanel>
            </Grid>

            <!-- 3. Loading Progress Ring -->
            <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.IsCalculating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,32">
                    <ProgressRing IsActive="True" Style="{StaticResource LoadingIndicatorStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.CalculationStatus, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
            </Grid>

            <!-- Error Banner -->
            <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" HorizontalAlignment="Center">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" Foreground="{ThemeResource ErrorBrush}" />
                        <Button Content="{x:Bind ViewModel.RetryLabel, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.CalculateCommand, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 4. Result Summary 3-Column Card (Prominent display) -->
            <Grid Grid.Row="3" ColumnSpacing="16" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.CalculatedInterestLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FormattedCalculatedInterest, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource PrimaryBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.CurrentPrincipalLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FormattedCurrentPrincipal, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource SuccessBrush}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.TotalPayableLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FormattedTotalPayable, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource PrimaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. Calculation Segments Breakdown Card (Full-width table) -->
            <Grid Grid.Row="4" Visibility="{x:Bind ViewModel.HasResult, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.BreakdownLabel, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" Margin="0,0,0,18" />

                        <!-- Scrollable Segments Table Container -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <StackPanel MinWidth="850">
                                <!-- Table Header Row -->
                                <Grid ColumnSpacing="8" Padding="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="11*" MinWidth="75" />
                                        <ColumnDefinition Width="11*" MinWidth="75" />
                                        <ColumnDefinition Width="12*" MinWidth="80" />
                                        <ColumnDefinition Width="7*" MinWidth="50" />
                                        <ColumnDefinition Width="6*" MinWidth="45" />
                                        <ColumnDefinition Width="8*" MinWidth="55" />
                                        <ColumnDefinition Width="10*" MinWidth="70" />
                                        <ColumnDefinition Width="13*" MinWidth="85" />
                                        <ColumnDefinition Width="11*" MinWidth="75" />
                                        <ColumnDefinition Width="11*" MinWidth="75" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.StartLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.EndLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.PrincipalLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.RatePercentLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.DaysLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.DaysPerMonthLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="6" Text="{x:Bind ViewModel.InterestColumnLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,20,0" />
                                    <TextBlock Grid.Column="7" Text="{x:Bind ViewModel.TransactionColumnLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Left" Margin="12,0,0,0" />
                                    <TextBlock Grid.Column="8" Text="{x:Bind ViewModel.AmountColumnLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="9" Text="{x:Bind ViewModel.ClosingColumnLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </Grid>

                                <!-- Table Data Rows ListView -->
                                <ListView ItemsSource="{x:Bind ViewModel.CalculationSegments, Mode=OneWay}" SelectionMode="None"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="MinHeight" Value="40" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="VerticalContentAlignment" Value="Center" />
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:InterestCalculationSegment">
                                            <Grid ColumnSpacing="8" MinHeight="40" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="11*" MinWidth="75" />
                                                    <ColumnDefinition Width="11*" MinWidth="75" />
                                                    <ColumnDefinition Width="12*" MinWidth="80" />
                                                    <ColumnDefinition Width="7*" MinWidth="50" />
                                                    <ColumnDefinition Width="6*" MinWidth="45" />
                                                    <ColumnDefinition Width="8*" MinWidth="55" />
                                                    <ColumnDefinition Width="10*" MinWidth="70" />
                                                    <ColumnDefinition Width="13*" MinWidth="85" />
                                                    <ColumnDefinition Width="11*" MinWidth="75" />
                                                    <ColumnDefinition Width="11*" MinWidth="75" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind SegmentStartDate, Mode=OneTime, Converter={StaticResource DateTimeFormatConverter}, ConverterParameter=short}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind SegmentEndDate, Mode=OneTime, Converter={StaticResource DateTimeFormatConverter}, ConverterParameter=short}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind OpeningPrincipal, Mode=OneTime, Converter={StaticResource LocalizedNumberConverter}}" FontSize="12" Foreground="{ThemeResource SuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="3" Text="{x:Bind ApplicableMonthlyRate, Mode=OneTime, Converter={StaticResource LocalizedNumberConverter}}" FontSize="12" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="4" Text="{x:Bind ElapsedDays, Mode=OneTime, Converter={StaticResource LocalizedNumberConverter}}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="5" Text="{x:Bind DaysInMonth, Mode=OneTime, Converter={StaticResource LocalizedNumberConverter}}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="6" Text="{x:Bind CalculatedInterest, Mode=OneTime, Converter={StaticResource LocalizedNumberConverter}}" FontSize="12" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0" />
                                                <TextBlock Grid.Column="7" Text="{x:Bind TransactionType, Mode=OneTime, Converter={StaticResource TextToLocalizedTextConverter}}" FontSize="12" Foreground="{x:Bind TransactionType, Mode=OneTime, Converter={StaticResource StatusToBrushConverter}}" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="12,0,0,0" />
                                                <TextBlock Grid.Column="8" Text="{x:Bind TransactionAmount, Mode=OneTime, Converter={StaticResource LocalizedNumberConverter}}" FontSize="12" Foreground="{x:Bind TransactionType, Mode=OneTime, Converter={StaticResource StatusToBrushConverter}}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="9" Text="{x:Bind ClosingPrincipal, Mode=OneTime, Converter={StaticResource LocalizedNumberConverter}}" FontSize="12" Foreground="{ThemeResource SuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- 6. Account Closed Banner -->
            <Grid Grid.Row="5" Visibility="{x:Bind ViewModel.IsClosed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource ErrorBrush}" BorderThickness="1">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.AccountClosedLabel, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource ErrorBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.ClosedDateLabel, Mode=OneWay}" FontSize="12" />
                            <TextBlock Text="{x:Bind ViewModel.FormattedClosedDate, Mode=OneWay}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DhirDhar.Desktop.Views.Shell.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DhirDhar.Desktop.Converters"
    Background="{ThemeResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:SidebarLengthConverter x:Key="SidebarLengthConverter" />
        <converters:SidebarThicknessConverter x:Key="SidebarThicknessConverter" />
        <converters:SidebarDoubleConverter x:Key="SidebarDoubleConverter" />
        <converters:SidebarAlignmentConverter x:Key="SidebarAlignmentConverter" />

        <ControlTemplate x:Key="NavButtonTemplate" TargetType="Button">
            <Grid>
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="RootBackground.Background" Value="{ThemeResource PrimaryBrush}" />
                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PrimaryForegroundBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="RootBackground.Background" Value="{ThemeResource PrimaryBrush}" />
                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PrimaryForegroundBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Target="RootBackground.Background" Value="{ThemeResource ButtonBackgroundDisabled}" />
                                <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource ButtonForegroundDisabled}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border x:Name="RootBackground"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter x:Name="ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Padding="{TemplateBinding Padding}"
                                      AutomationProperties.AccessibilityView="Raw" />
                </Border>
            </Grid>
        </ControlTemplate>

        <Style x:Key="NavItemStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Template" Value="{StaticResource NavButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource ApplicationForegroundBrush}" />
        </Style>

        <Style x:Key="NavItemSelectedStyle" TargetType="Button">
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Template" Value="{StaticResource NavButtonTemplate}" />
            <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource PrimaryForegroundBrush}" />
        </Style>

        <Style x:Key="NavLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Left" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=SidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Sidebar -->
        <Grid Grid.Column="0"
               Background="{ThemeResource SurfaceBackgroundBrush}"
               BorderBrush="{ThemeResource BorderBrush}"
               BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Sidebar Top Controls -->
            <Grid Grid.Row="0" Padding="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarThicknessConverter}, ConverterParameter=HeaderPadding}">
                <Button x:Name="MenuButton"
                        Width="40"
                        Height="40"
                        CornerRadius="8"
                        Background="Transparent"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarAlignmentConverter}}"
                        Click="OnMenuButtonClick"
                        AutomationProperties.Name="{x:Bind ViewModel.MenuLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.MenuLabel, Mode=OneWay}">
                    <FontIcon Glyph="&#xE700;" FontSize="18" />
                </Button>
            </Grid>

            <!-- Navigation Items -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,8">
                <StackPanel Spacing="6">
                    <Button x:Name="NavDashboard"
                            Style="{StaticResource NavItemSelectedStyle}"
                            Tag="Dashboard"
                            Click="OnNavItemClick"
                            AutomationProperties.Name="{x:Bind ViewModel.NavDashboardText, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavIcon}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavGap}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavText}" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Width="40"
                                  Height="44"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE80F;"
                                          FontSize="20"
                                          Width="20"
                                          Height="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.NavDashboardText, Mode=OneWay}" Style="{StaticResource NavLabelStyle}" Visibility="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavBorrowers"
                            Style="{StaticResource NavItemStyle}"
                            Tag="Borrowers"
                            Click="OnNavItemClick"
                            AutomationProperties.Name="{x:Bind ViewModel.NavBorrowersText, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavIcon}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavGap}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavText}" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Width="40"
                                  Height="44"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE716;"
                                          FontSize="20"
                                          Width="20"
                                          Height="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.NavBorrowersText, Mode=OneWay}" Style="{StaticResource NavLabelStyle}" Visibility="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavTransactions"
                            Style="{StaticResource NavItemStyle}"
                            Tag="Transactions"
                            Click="OnNavItemClick"
                            AutomationProperties.Name="{x:Bind ViewModel.NavTransactionsText, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavIcon}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavGap}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavText}" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Width="40"
                                  Height="44"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <TextBlock Text="₹"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.NavTransactionsText, Mode=OneWay}" Style="{StaticResource NavLabelStyle}" Visibility="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavInterest"
                            Style="{StaticResource NavItemStyle}"
                            Tag="Interest"
                            Click="OnNavItemClick"
                            AutomationProperties.Name="{x:Bind ViewModel.NavInterestText, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavIcon}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavGap}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavText}" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Width="40"
                                  Height="44"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8A1;"
                                          FontSize="20"
                                          Width="20"
                                          Height="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.NavInterestText, Mode=OneWay}" Style="{StaticResource NavLabelStyle}" Visibility="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavLedger"
                            Style="{StaticResource NavItemStyle}"
                            Tag="Ledger"
                            Click="OnNavItemClick"
                            AutomationProperties.Name="{x:Bind ViewModel.NavLedgerText, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavIcon}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavGap}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavText}" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Width="40"
                                  Height="44"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE7C3;"
                                          FontSize="20"
                                          Width="20"
                                          Height="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.NavLedgerText, Mode=OneWay}" Style="{StaticResource NavLabelStyle}" Visibility="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavReports"
                            Style="{StaticResource NavItemStyle}"
                            Tag="Reports"
                            Click="OnNavItemClick"
                            AutomationProperties.Name="{x:Bind ViewModel.NavReportsText, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavIcon}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavGap}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavText}" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Width="40"
                                  Height="44"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9F9;"
                                          FontSize="20"
                                          Width="20"
                                          Height="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.NavReportsText, Mode=OneWay}" Style="{StaticResource NavLabelStyle}" Visibility="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavBackup"
                            Style="{StaticResource NavItemStyle}"
                            Tag="BackupRestore"
                            Click="OnNavItemClick"
                            AutomationProperties.Name="{x:Bind ViewModel.NavBackupText, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavIcon}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavGap}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavText}" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Width="40"
                                  Height="44"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE777;"
                                          FontSize="20"
                                          Width="20"
                                          Height="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.NavBackupText, Mode=OneWay}" Style="{StaticResource NavLabelStyle}" Visibility="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavSecurity"
                            Style="{StaticResource NavItemStyle}"
                            Tag="Security"
                            Click="OnNavItemClick"
                            AutomationProperties.Name="{x:Bind ViewModel.NavSecurityText, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavIcon}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavGap}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavText}" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Width="40"
                                  Height="44"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;"
                                          FontSize="20"
                                          Width="20"
                                          Height="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.NavSecurityText, Mode=OneWay}" Style="{StaticResource NavLabelStyle}" Visibility="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavIntegrity"
                            Style="{StaticResource NavItemStyle}"
                            Tag="Integrity"
                            Click="OnNavItemClick"
                            AutomationProperties.Name="{x:Bind ViewModel.NavIntegrityText, Mode=OneWay}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavIcon}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavGap}" />
                                <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=NavText}" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0"
                                  Width="40"
                                  Height="44"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE9D5;"
                                          FontSize="20"
                                          Width="20"
                                          Height="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.NavIntegrityText, Mode=OneWay}" Style="{StaticResource NavLabelStyle}" Visibility="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Business Card at Bottom -->
            <Border Grid.Row="2"
                    Margin="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarThicknessConverter}, ConverterParameter=CardMargin}"
                    Height="72"
                    CornerRadius="8"
                    BorderBrush="{ThemeResource BorderBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource ApplicationBackgroundBrush}">
                <Grid Padding="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarThicknessConverter}, ConverterParameter=CardPadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=CardLogoCol}" />
                        <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=CardTextCol}" />
                        <ColumnDefinition Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarLengthConverter}, ConverterParameter=CardOptionsCol}" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                           Width="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarDoubleConverter}, ConverterParameter=LogoSize}"
                           Height="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarDoubleConverter}, ConverterParameter=LogoSize}"
                           Margin="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarThicknessConverter}, ConverterParameter=LogoMargin}"
                           HorizontalAlignment="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource SidebarAlignmentConverter}}"
                           VerticalAlignment="Center"
                           Source="ms-appx:///Assets/DhirDharLogo.png"
                           Stretch="Uniform" />
                    <TextBlock Grid.Column="1" Grid.Row="0"
                               Text="{Binding ApplicationTitle, Mode=OneWay}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TextBlock Grid.Column="1" Grid.Row="1"
                               Text="{Binding FormattedFinancialYear, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource SubtleForegroundBrush}"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <Button Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                            Width="24"
                            Height="24"
                            CornerRadius="4"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsSidebarExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.Name="{x:Bind ViewModel.BusinessOptionsLabel, Mode=OneWay}">
                        <FontIcon Glyph="&#xE70D;" FontSize="12" />
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- Main Content Area with License Banner -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border
                x:Name="LicenseBanner"
                Grid.Row="0"
                Visibility="Collapsed"
                Padding="16,10"
                BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10" Grid.Column="0" VerticalAlignment="Center">
                        <FontIcon x:Name="LicenseBannerIcon" Glyph="&#xE7BA;" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock x:Name="LicenseBannerText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button
                        x:Name="RenewLicenseButton"
                        Grid.Column="1"
                        Click="OnRenewLicenseClick"
                        Content="{x:Bind ViewModel.RenewLicenseLabel, Mode=OneWay}"
                        Padding="14,6"
                        FontSize="12"
                        FontWeight="SemiBold"
                        CornerRadius="6"
                        VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Frame Grid.Row="1"
                   x:Name="ContentFrame"
                   x:FieldModifier="Public"
                   Padding="0" />
        </Grid>
    </Grid>
</Page>

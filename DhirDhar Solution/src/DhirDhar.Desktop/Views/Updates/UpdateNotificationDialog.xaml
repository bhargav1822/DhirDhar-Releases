<ContentDialog
    x:Class="DhirDhar.Desktop.Views.Updates.UpdateNotificationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DhirDhar.Desktop.Converters"
    Background="{ThemeResource ApplicationBackgroundBrush}"
    PrimaryButtonStyle="{StaticResource PrimaryButtonStyle}">

    <ContentDialog.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
    </ContentDialog.Resources>

    <ContentDialog.Content>
        <StackPanel Spacing="12" MinWidth="300" MaxWidth="480" MaxHeight="520">
            <TextBlock Text="{Binding DialogTitle, Mode=OneTime}"
                       Style="{StaticResource TitleTextStyle}"
                       Foreground="{ThemeResource ApplicationForegroundBrush}"
                       TextWrapping="Wrap" />

            <Border Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding CurrentVersionLabel, Mode=OneTime}" Style="{StaticResource SubtleTextStyle}" />
                    <TextBlock Text="{Binding CurrentVersion, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" />

                    <TextBlock Text="{Binding NewVersionLabel, Mode=OneTime}" Style="{StaticResource SubtleTextStyle}" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding NewVersion, Mode=OneWay}" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                <ScrollViewer MaxHeight="160" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding ReleaseNotesLabel, Mode=OneTime}"
                                   Style="{StaticResource SubtleTextStyle}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ReleaseNotes, Mode=OneWay}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource ApplicationForegroundBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="8" Padding="16" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                    Visibility="{Binding IsApplying, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="8" Orientation="Horizontal" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="20" Height="20" />
                    <TextBlock Text="{Binding StatusText, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </Border>

            <Border Background="{ThemeResource ErrorBrush}" Opacity="0.08" CornerRadius="8" Padding="12"
                    Visibility="{Binding HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}"
                           Style="{StaticResource BodyTextStyle}"
                           Foreground="{ThemeResource ErrorBrush}"
                           TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ContentDialog.Content>
</ContentDialog>

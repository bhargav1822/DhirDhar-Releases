<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DhirDhar.Desktop.Views.Transactions.TransactionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DhirDhar.Desktop.Converters"
    xmlns:appModels="using:DhirDhar.Application.Borrowers.Models"
    xmlns:vm="using:DhirDhar.Desktop.ViewModels.Transactions"
    xmlns:helpers="using:DhirDhar.Desktop.Helpers"
    xmlns:controls="using:DhirDhar.Desktop.Controls"
    Background="{ThemeResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:DigitLocalizingConverter x:Key="DigitLocalizingConverter" />

        <Style x:Key="TableListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="24,20" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. Header Section -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" FontSize="24" FontWeight="Bold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource SubtleForegroundBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" ToolTipService.ToolTip="{x:Bind ViewModel.RefreshLabel, Mode=OneWay}" Height="36" Width="36" Padding="0" CornerRadius="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                    </Button>
                    <Button Command="{x:Bind ViewModel.ToggleAddTransactionCommand, Mode=OneWay}" Background="{ThemeResource PrimaryBrush}" Foreground="White" Height="36" Padding="14,0" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontSize="13" />
                            <TextBlock Text="{x:Bind ViewModel.NewTransactionLabel, Mode=OneWay}" FontWeight="SemiBold" FontSize="13" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Financial Summary Cards -->
            <Grid Grid.Row="1" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Total Deposits Card (Received) -->
                <Button Grid.Column="0"
                        Command="{x:Bind ViewModel.SelectDepositsFilterCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ClickToFilterDepositsLabel, Mode=OneWay}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource SurfaceBackgroundBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.TotalDepositsLabel, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="Medium" />
                        <TextBlock Text="{x:Bind ViewModel.FormattedTotalDeposits, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource SuccessBrush}" />
                    </StackPanel>
                </Button>

                <!-- Total Withdrawals Card (Given / Loan) -->
                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.SelectWithdrawalsFilterCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ClickToFilterWithdrawalsLabel, Mode=OneWay}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource SurfaceBackgroundBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.TotalWithdrawalsLabel, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="Medium" />
                        <TextBlock Text="{x:Bind ViewModel.FormattedTotalWithdrawals, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource ErrorBrush}" />
                    </StackPanel>
                </Button>

                <!-- Net Position Card -->
                <Button Grid.Column="2"
                        Command="{x:Bind ViewModel.SelectAllFilterCommand, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ClickToViewAllLabel, Mode=OneWay}"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Background="{ThemeResource SurfaceBackgroundBrush}"
                        BorderBrush="{ThemeResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{x:Bind ViewModel.NetPositionLabel, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource SubtleForegroundBrush}" FontWeight="Medium" />
                        <TextBlock Text="{x:Bind ViewModel.FormattedNetFinancialPosition, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource PrimaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- 3. New Transaction Entry Form (Collapsible) -->
            <Border Grid.Row="2"
                    Visibility="{Binding IsAddingTransaction, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{ThemeResource SurfaceBackgroundBrush}"
                    BorderBrush="{ThemeResource PrimaryBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="{Binding NewTransactionEntryLabel, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Command="{Binding ToggleAddTransactionCommand, Mode=OneWay}" HorizontalAlignment="Right" Height="32" Width="32" Padding="0" CornerRadius="6">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="12" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Borrower Search (Live search as you type) -->
                        <AutoSuggestBox Grid.Column="0"
                                        x:Name="NewTransactionBorrowerSearchBox"
                                        Header="{Binding BorrowerSearchLabel, Mode=OneWay}"
                                        PlaceholderText="{Binding BorrowerSearchPlaceholder, Mode=OneWay}"
                                        Text="{Binding NewBorrowerSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ItemsSource="{Binding NewBorrowerSearchResults, Mode=OneWay}"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate x:DataType="appModels:BorrowerSummary">
                                    <StackPanel Padding="4,4">
                                        <TextBlock Text="{x:Bind FullName, Mode=OneTime}" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{x:Bind FormattedBorrowerNumber, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" Foreground="{ThemeResource PrimaryBrush}" FontSize="12" />
                                    </StackPanel>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>

                        <!-- Transaction Type -->
                        <ComboBox Grid.Column="1"
                                  Header="{Binding TypeLabel, Mode=OneWay}"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding TransactionTypeOptions, Mode=OneWay}"
                                  SelectedValue="{Binding NewType, Mode=TwoWay}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label" />

                        <!-- Transaction Date -->
                        <DatePicker Grid.Column="2"
                                    Header="{Binding TransactionDateLabel, Mode=OneWay}"
                                    HorizontalAlignment="Stretch"
                                    helpers:DatePickerLocalization.IsEnabled="True"
                                    SelectedDate="{Binding NewOccurredOn, Mode=TwoWay}" />

                        <!-- Amount -->
                        <TextBox Grid.Column="3"
                                 x:Name="NewTransactionAmountTextBox"
                                 Header="{Binding AmountLabel, Mode=OneWay}"
                                 Text="{Binding NewAmountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="0.00"
                                 InputScope="Number" />
                    </Grid>

                    <!-- Notes / Description -->
                    <controls:DhirDharPhoneticTextBox Header="{Binding NotesDescriptionLabel, Mode=OneWay}"
                             Text="{Binding NewNotes, Mode=TwoWay}"
                             PlaceholderText="{Binding EnterReferenceLabel, Mode=OneWay}" />

                    <!-- Save & Cancel Action Buttons -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{Binding CancelLabel, Mode=OneWay}" Command="{Binding ToggleAddTransactionCommand, Mode=OneWay}" Height="36" Padding="14,0" CornerRadius="6" />
                        <Button Content="{Binding SaveTransactionLabel, Mode=OneWay}" Command="{Binding CreateTransactionCommand, Mode=OneWay}" Background="{ThemeResource PrimaryBrush}" Foreground="White" Height="36" Padding="16,0" CornerRadius="6" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 4. Filter & Search Controls Bar -->
            <Border Grid.Row="3" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <controls:DhirDharPhoneticTextBox FieldType="SearchText" Grid.Column="0" Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PlaceholderText="{x:Bind ViewModel.SearchPlaceholder, Mode=OneWay}" VerticalAlignment="Center" Height="36" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Content="{x:Bind ViewModel.AllLabel, Mode=OneWay}" Command="{x:Bind ViewModel.SelectAllFilterCommand, Mode=OneWay}" Height="36" Padding="14,0" CornerRadius="6" VerticalAlignment="Center" />
                        <Button Content="{x:Bind ViewModel.GivenLoanLabel, Mode=OneWay}" Command="{x:Bind ViewModel.SelectWithdrawalsFilterCommand, Mode=OneWay}" Height="36" Padding="14,0" CornerRadius="6" VerticalAlignment="Center" />
                        <Button Content="{x:Bind ViewModel.ReceivedDepositLabel, Mode=OneWay}" Command="{x:Bind ViewModel.SelectDepositsFilterCommand, Mode=OneWay}" Height="36" Padding="14,0" CornerRadius="6" VerticalAlignment="Center" />
                        <Button Content="{x:Bind ViewModel.ClearLabel, Mode=OneWay}" Command="{x:Bind ViewModel.ClearFiltersCommand, Mode=OneWay}" Height="36" Padding="12,0" CornerRadius="6" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Error Banner -->
            <Border Grid.Row="4"
                    Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                    CornerRadius="6"
                    Padding="14,10">
                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="13" />
            </Border>

            <!-- 6. Recent Transactions Table Container -->
            <Border Grid.Row="5" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{x:Bind ViewModel.RecentTransactionsLabel, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,2" />

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1"
                                Visibility="{x:Bind ViewModel.HasNoTransactions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Padding="32">
                        <FontIcon Glyph="&#xE8A5;" FontSize="36" Foreground="{ThemeResource SubtleForegroundBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.NoTransactionsTitleLabel, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.NoTransactionsDescLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- Scrollable Table for low-res & high-DPI scaling -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Visibility="{x:Bind ViewModel.HasTransactions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid MinWidth="850" RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Table Header -->
                            <Border Grid.Row="0" Background="{ThemeResource ApplicationBackgroundBrush}" CornerRadius="6" Padding="12,8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" MinWidth="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="35" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.TransactionDateLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.BorrowerLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.TypeLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.NotesDescriptionLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.AmountLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.NetPositionLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="6" Text="" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Transactions List -->
                            <ListView Grid.Row="1"
                                      ItemsSource="{x:Bind ViewModel.DisplayTransactions, Mode=OneWay}"
                                      IsItemClickEnabled="True"
                                      ItemClick="TransactionListView_ItemClick"
                                      SelectionMode="None"
                                      ItemContainerStyle="{StaticResource TableListViewItemStyle}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TransactionRowItem">
                                        <Grid Padding="0,4" ColumnSpacing="12" MinHeight="44" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" MinWidth="130" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="35" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Date -->
                                            <TextBlock Grid.Column="0" Text="{x:Bind FormattedDate}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource SubtleForegroundBrush}" TextWrapping="NoWrap" />

                                            <!-- Borrower Info -->
                                            <TextBlock Grid.Column="1" Text="{x:Bind FormattedBorrowerInfo}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                            <!-- Transaction Type Badge -->
                                            <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="4" Padding="8,3" Background="{ThemeResource ApplicationBackgroundBrush}">
                                                <TextBlock Text="{x:Bind LocalizedDisplayType}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind SemanticBrushKey, Converter={StaticResource StatusToBrushConverter}}" TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <!-- Description -->
                                            <TextBlock Grid.Column="3" Text="{x:Bind Description}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource SubtleForegroundBrush}" />

                                            <!-- Amount -->
                                            <TextBlock Grid.Column="4" Text="{x:Bind FormattedAmount}" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{x:Bind SemanticBrushKey, Converter={StaticResource StatusToBrushConverter}}" TextTrimming="CharacterEllipsis" />

                                            <!-- Running Balance -->
                                            <TextBlock Grid.Column="5" Text="{x:Bind FormattedRunningBalance}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource SubtleForegroundBrush}" TextTrimming="CharacterEllipsis" />

                                            <!-- Chevron -->
                                            <FontIcon Grid.Column="6" Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>

<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DhirDhar.Desktop.Views.Ledger.LedgerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DhirDhar.Desktop.Converters"
    xmlns:models="using:DhirDhar.Application.Ledger.Models"
    xmlns:helpers="using:DhirDhar.Desktop.Helpers"
    xmlns:controls="using:DhirDhar.Desktop.Controls"
    Background="{ThemeResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:TextToLocalizedTextConverter x:Key="TextToLocalizedTextConverter" />
        <converters:DigitLocalizingConverter x:Key="DigitLocalizingConverter" />

        <Style x:Key="TableListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="24,20" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header Section -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{x:Bind ViewModel.RefreshText, Mode=OneWay}"
                        Height="36" Padding="14,0" CornerRadius="6" VerticalAlignment="Center"
                        Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" />
            </Grid>

            <!-- 2. Financial Summary Cards -->
            <Grid Grid.Row="1" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Current Balance Card -->
                <Border Grid.Column="0" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.OpeningBalanceLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FormattedOpeningBalance, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource SuccessBrush}" />
                    </StackPanel>
                </Border>

                <!-- Total Deposits Card -->
                <Border Grid.Column="1" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.TotalCreditsLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FormattedTotalInterest, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource PrimaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Total Outstanding Card -->
                <Border Grid.Column="2" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.ClosingBalanceLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.FormattedCurrentOutstanding, Mode=OneWay}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource SuccessBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Single Horizontal Filter & Search Bar -->
            <Border Grid.Row="2" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Start Date Picker -->
                    <CalendarDatePicker Grid.Column="0" Height="36" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                        helpers:DatePickerLocalization.IsEnabled="True"
                                        PlaceholderText="{x:Bind ViewModel.StartDateLabel, Mode=OneWay}"
                                        Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}" />

                    <!-- End Date Picker -->
                    <CalendarDatePicker Grid.Column="1" Height="36" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                        helpers:DatePickerLocalization.IsEnabled="True"
                                        PlaceholderText="{x:Bind ViewModel.EndDateLabel, Mode=OneWay}"
                                        Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}" />

                    <!-- Event Type ComboBox -->
                    <ComboBox Grid.Column="2" Height="36" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                              PlaceholderText="{x:Bind ViewModel.EventTypeLabel, Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.EventTypeOptions, Mode=OneWay}"
                              SelectedValue="{x:Bind ViewModel.EventTypeFilter, Mode=TwoWay}"
                              SelectedValuePath="Value" DisplayMemberPath="Label" />

                    <!-- Search Input -->
                    <controls:DhirDharPhoneticTextBox FieldType="SearchText" Grid.Column="3" Height="36" VerticalAlignment="Center"
                             PlaceholderText="{x:Bind ViewModel.SearchPlaceholderLabel, Mode=OneWay}"
                             Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchTextBox_KeyDown" />

                    <!-- Clear Button -->
                    <Button Grid.Column="4" Height="36" Padding="14,0" CornerRadius="6" VerticalAlignment="Center"
                            Content="{x:Bind ViewModel.ClearLabel, Mode=OneWay}"
                            Command="{x:Bind ViewModel.ClearFiltersCommand, Mode=OneWay}" />
                </Grid>
            </Border>

            <!-- 4. Progress & Error States -->
            <ProgressRing Grid.Row="3" HorizontalAlignment="Center"
                          Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <Grid Grid.Row="3" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="8" Padding="20" HorizontalAlignment="Center">
                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource ErrorBrush}" />
                        <Button Content="{x:Bind ViewModel.RetryText, Mode=OneWay}" Height="36" Padding="16,0" CornerRadius="6"
                                Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 5. Ledger Table Container -->
            <Border Grid.Row="4" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16"
                    Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid MinWidth="850" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header Row -->
                        <Border Grid.Row="0" Background="{ThemeResource ApplicationBackgroundBrush}" CornerRadius="6" Padding="12,8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="105" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="115" />
                                    <ColumnDefinition Width="85" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.DateHeaderLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.TypeHeaderLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DescriptionHeaderLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{x:Bind ViewModel.AmountHeaderLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="4" Text="{x:Bind ViewModel.InterestHeaderLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="5" Text="{x:Bind ViewModel.RateHeaderLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="6" Text="{x:Bind ViewModel.OpeningHeaderLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="7" Text="{x:Bind ViewModel.ClosingHeaderLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="8" Text="{x:Bind ViewModel.RefHeaderLabel, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- Data List -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Entries, Mode=OneWay}" SelectionMode="None" ItemContainerStyle="{StaticResource TableListViewItemStyle}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:LedgerEntryDto">
                                    <Grid ColumnSpacing="8" Padding="0,4" MinHeight="38" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="115" />
                                            <ColumnDefinition Width="115" />
                                            <ColumnDefinition Width="85" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Date -->
                                        <TextBlock Grid.Column="0" Text="{x:Bind FormattedDate, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource SubtleForegroundBrush}" TextWrapping="NoWrap" />

                                        <!-- Event Type Badge -->
                                        <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" CornerRadius="4" Padding="6,2" Background="{ThemeResource ApplicationBackgroundBrush}">
                                            <TextBlock Text="{x:Bind EventType, Converter={StaticResource TextToLocalizedTextConverter}}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind EventType, Converter={StaticResource StatusToBrushConverter}}" TextTrimming="CharacterEllipsis" />
                                        </Border>

                                        <!-- Description -->
                                        <TextBlock Grid.Column="2" Text="{x:Bind Description, Converter={StaticResource TextToLocalizedTextConverter}}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                        <!-- Amount -->
                                        <TextBlock Grid.Column="3" Text="{x:Bind FormattedTransactionAmount, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{x:Bind EventType, Converter={StaticResource StatusToBrushConverter}}" TextTrimming="CharacterEllipsis" />

                                        <!-- Interest -->
                                        <TextBlock Grid.Column="4" Text="{x:Bind FormattedInterestAmount, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource PrimaryBrush}" TextTrimming="CharacterEllipsis" />

                                        <!-- Rate -->
                                        <TextBlock Grid.Column="5" Text="{x:Bind FormattedRate, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{ThemeResource PrimaryBrush}" TextTrimming="CharacterEllipsis" />

                                        <!-- Opening -->
                                        <TextBlock Grid.Column="6" Text="{x:Bind FormattedOpeningPrincipal, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource SuccessBrush}" TextTrimming="CharacterEllipsis" />

                                        <!-- Closing -->
                                        <TextBlock Grid.Column="7" Text="{x:Bind FormattedClosingPrincipal, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource SuccessBrush}" TextTrimming="CharacterEllipsis" />

                                        <!-- Ref -->
                                        <TextBlock Grid.Column="8" Text="{x:Bind Reference}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource SubtleForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- 6. Account Closed Banner -->
            <Grid Grid.Row="5" Visibility="{x:Bind ViewModel.IsClosed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="8" Padding="14,10" BorderBrush="{ThemeResource ErrorBrush}" BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind ViewModel.AccountClosedLabel, Mode=OneWay}" FontSize="14" FontWeight="Bold" Foreground="{ThemeResource ErrorBrush}" />
                        <TextBlock FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}">
                            <Run Text="{x:Bind ViewModel.ClosedDateLabel, Mode=OneWay}" />
                            <Run Text="{x:Bind ViewModel.FormattedClosedDate, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Text="{x:Bind ViewModel.NoInterestAfterClosedLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SubtleForegroundBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

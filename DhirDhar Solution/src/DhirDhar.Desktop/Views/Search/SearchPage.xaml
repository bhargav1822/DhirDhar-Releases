<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DhirDhar.Desktop.Views.Search.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DhirDhar.Desktop.Converters"
    xmlns:models="using:DhirDhar.Application.Search.Models"
    xmlns:helpers="using:DhirDhar.Desktop.Helpers"
    xmlns:controls="using:DhirDhar.Desktop.Controls"
    Background="{ThemeResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:DigitLocalizingConverter x:Key="DigitLocalizingConverter" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource HeadingTextStyle}" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:DhirDharPhoneticTextBox FieldType="SearchText" Grid.Column="0" PlaceholderText="{x:Bind ViewModel.SearchPlaceholderLabel, Mode=OneWay}" Text="{x:Bind ViewModel.SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="SearchTextBox_KeyDown" />

            <ComboBox Grid.Column="1" ItemsSource="{x:Bind ViewModel.CategoryOptions, Mode=OneWay}" SelectedValue="{x:Bind ViewModel.SelectedCategory, Mode=TwoWay}" SelectedValuePath="Value" DisplayMemberPath="Label" MinWidth="120" />

            <Button Grid.Column="2" Content="{x:Bind ViewModel.SearchButtonLabel, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.SearchCommand, Mode=OneWay}" />
            <Button Grid.Column="3" Content="{x:Bind ViewModel.ClearButtonLabel, Mode=OneWay}" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.ClearFiltersCommand, Mode=OneWay}" />
        </Grid>

        <Grid Grid.Row="2">
            <ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- Error Banner -->
            <Grid Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="8" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" Foreground="{ThemeResource ErrorBrush}" />
                        <Button Content="{x:Bind ViewModel.RetryLabel, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.SearchCommand, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Empty Results State -->
            <Border Visibility="{x:Bind ViewModel.HasNoResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                    Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="12" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xE721;" FontSize="40" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.NoResultsFoundLabel, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Bind ViewModel.NoResultsFoundSubtitle, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Results List -->
            <ListView ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
                      Visibility="{x:Bind ViewModel.HasResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SearchResult">
                        <Grid Padding="12,8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{x:Bind EntityType}" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Title}" Style="{StaticResource BodyTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Status}" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Subtitle, Converter={StaticResource DigitLocalizingConverter}}" Style="{StaticResource SubtleTextStyle}" />
                            <TextBlock Grid.Column="4" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Right">
                                <Run Text="{x:Bind Amount, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

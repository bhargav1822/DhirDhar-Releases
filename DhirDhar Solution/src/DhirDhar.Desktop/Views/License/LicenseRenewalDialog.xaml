<ContentDialog
    x:Class="DhirDhar.Desktop.Views.License.LicenseRenewalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:helpers="using:DhirDhar.Desktop.Helpers"
    mc:Ignorable="d"
    Title="{x:Bind ViewModel.RenewLicenseTitleLabel, Mode=OneWay}"
    PrimaryButtonText="{x:Bind ViewModel.ActivateNewKeyLabel, Mode=OneWay}"
    CloseButtonText="{x:Bind ViewModel.CancelLabel, Mode=OneWay}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanActivate, Mode=OneWay}"
    CornerRadius="12"
    Background="{ThemeResource SurfaceBackgroundBrush}">

    <StackPanel Spacing="16" MinWidth="300" MaxWidth="500" Margin="0,8,0,0">
        
        <TextBlock
            Text="{x:Bind ViewModel.RenewLicenseInstructionsLabel, Mode=OneWay}"
            FontSize="13"
            TextWrapping="Wrap"
            Foreground="{ThemeResource SubtleForegroundBrush}"/>

        <Border
            Background="{ThemeResource ApplicationBackgroundBrush}"
            BorderBrush="{ThemeResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,8">
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="{x:Bind ViewModel.HardwareIdLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center"/>
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.DeviceId, Mode=OneWay}"
                    FontSize="12"
                    FontFamily="Consolas, Segoe UI Mono, Courier New"
                    Foreground="{ThemeResource ApplicationForegroundBrush}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{x:Bind ViewModel.SerialKeyLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}"/>
                <Button
                    Grid.Column="1"
                    Command="{x:Bind ViewModel.PasteCommand}"
                    Padding="6,2"
                    Background="Transparent"
                    BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon Glyph="&#xE77F;" FontSize="11" Foreground="{ThemeResource PrimaryBrush}"/>
                        <TextBlock Text="{x:Bind ViewModel.PasteTooltipLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource PrimaryBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <TextBox
                x:Name="RenewalKeyTextBox"
                helpers:IndicInput.IsDisabled="True"
                Text="{x:Bind ViewModel.SerialKeyInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                PlaceholderText="XXXXX-XXXXX-XXXXX-XXXXX-XXXXX"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                MinHeight="80"
                MaxHeight="120"
                FontFamily="Consolas, Segoe UI Mono, Courier New"
                FontSize="12"
                CornerRadius="6"
                Background="{ThemeResource ApplicationBackgroundBrush}"
                BorderBrush="{ThemeResource BorderBrush}"/>
        </StackPanel>

        <InfoBar
            IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
            Severity="Error"
            Title="{x:Bind ViewModel.ActivationFailedLabel, Mode=OneWay}"
            Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
            IsClosable="False"/>

        <InfoBar
            IsOpen="{x:Bind ViewModel.IsSuccess, Mode=OneWay}"
            Severity="Success"
            Title="{x:Bind ViewModel.LicenseActivatedLabel, Mode=OneWay}"
            Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
            IsClosable="False"/>

    </StackPanel>
</ContentDialog>

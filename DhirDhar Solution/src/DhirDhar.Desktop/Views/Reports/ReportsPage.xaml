<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DhirDhar.Desktop.Views.Reports.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DhirDhar.Desktop.Converters"
    xmlns:local="using:DhirDhar.Desktop.Views.Reports"
    xmlns:models="using:DhirDhar.Application.Reports.Models"
    xmlns:appModels="using:DhirDhar.Application.Borrowers.Models"
    xmlns:ledgerModels="using:DhirDhar.Application.Ledger.Models"
    xmlns:helpers="using:DhirDhar.Desktop.Helpers"
    Background="{ThemeResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:BorrowerFilterVisibilityConverter x:Key="BorrowerFilterVisibilityConverter" />
        <converters:TransactionFilterVisibilityConverter x:Key="TransactionFilterVisibilityConverter" />
        <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:DigitLocalizingConverter x:Key="DigitLocalizingConverter" />
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
        <converters:TextToLocalizedTextConverter x:Key="TextToLocalizedTextConverter" />

        <!-- Borrower Statement Template -->
        <DataTemplate x:Key="BorrowerStatementTemplate" x:DataType="models:BorrowerStatementReport">
            <StackPanel Spacing="16">
                <!-- Borrower Profile Header Card -->
                <Border Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,16">
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Borrower Info Left -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind BorrowerName}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                                <Border Background="{ThemeResource ApplicationBackgroundBrush}" BorderBrush="{ThemeResource PrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind BorrowerNumber, Converter={StaticResource DigitLocalizingConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind Contact, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <FontIcon Glyph="&#xE717;" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind Contact, Converter={StaticResource DigitLocalizingConverter}}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE787;" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind FormattedDateRange, Converter={StaticResource DigitLocalizingConverter}}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8EC;" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind FormattedInterestRate, Converter={StaticResource DigitLocalizingConverter}}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Status Badge Right -->
                        <StackPanel Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="4">
                            <Border Background="{ThemeResource ApplicationBackgroundBrush}" BorderBrush="{x:Bind AccountStatus, Converter={StaticResource StatusToBrushConverter}}" BorderThickness="1" CornerRadius="12" Padding="12,4" HorizontalAlignment="Right">
                                <TextBlock Text="{x:Bind AccountStatus}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind AccountStatus, Converter={StaticResource StatusToBrushConverter}}" />
                            </Border>
                            <TextBlock Text="{x:Bind FormattedClosedDate, Converter={StaticResource DigitLocalizingConverter}}" FontSize="11" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right"
                                       Visibility="{x:Bind IsClosed, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 5 Summary Metric Cards -->
                <Grid ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Opening Balance -->
                    <Border Grid.Column="0" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Opening Balance" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedOpeningPrincipal, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Total Amount Given (Withdrawals) -->
                    <Border Grid.Column="1" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total Given (Debit)" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedTotalWithdrawals, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource ErrorBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Total Amount Received (Deposits) -->
                    <Border Grid.Column="2" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total Received (Credit)" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedTotalDeposits, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource SuccessBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Accrued Interest -->
                    <Border Grid.Column="3" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Accrued Interest" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedTotalInterest, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource WarningBrush}" />
                        </StackPanel>
                    </Border>

                    <!-- Final Outstanding -->
                    <Border Grid.Column="4" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Final Outstanding" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedFinalOutstanding, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="18" FontWeight="Bold" Foreground="{ThemeResource ErrorBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Transactions Table Card -->
                <Border Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel MinWidth="850">
                            <!-- Table Header -->
                            <Grid Padding="16,12" Background="{ThemeResource SecondaryBrush}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" MinWidth="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Date" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                                <TextBlock Grid.Column="1" Text="Type" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                                <TextBlock Grid.Column="2" Text="Debit / Given (₹)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                                <TextBlock Grid.Column="3" Text="Credit / Received (₹)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                                <TextBlock Grid.Column="4" Text="Interest (₹)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                                <TextBlock Grid.Column="5" Text="Closing Balance (₹)" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                                <TextBlock Grid.Column="6" Text="Description" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                            </Grid>

                            <!-- Empty State if no records -->
                            <StackPanel Visibility="{x:Bind HasFinancialHistory, Mode=OneTime, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32" Spacing="8">
                                <FontIcon Glyph="&#xE9CE;" FontSize="32" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No transactions found for the selected period." FontSize="14" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Center" />
                            </StackPanel>

                            <!-- Transactions List -->
                            <ListView ItemsSource="{x:Bind FinancialHistory, Mode=OneTime}" SelectionMode="None"
                                      Visibility="{x:Bind HasFinancialHistory, Mode=OneTime, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="ledgerModels:LedgerEntryDto">
                                        <Grid Padding="16,10" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,0.5" MinHeight="38" VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="140" />
                                                <ColumnDefinition Width="*" MinWidth="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind FormattedDate, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" Foreground="{ThemeResource ApplicationForegroundBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind EventType}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind FormattedDebitAmount, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" Foreground="{ThemeResource ErrorBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{x:Bind FormattedCreditAmount, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" Foreground="{ThemeResource SuccessBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" Text="{x:Bind FormattedInterestAmount, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" Foreground="{ThemeResource WarningBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="5" Text="{x:Bind FormattedClosingPrincipal, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="6" Text="{x:Bind Description, Converter={StaticResource TextToLocalizedTextConverter}}" FontSize="13" Foreground="{ThemeResource SubtleForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Transaction Report Template -->
        <DataTemplate x:Key="TransactionReportTemplate" x:DataType="models:TransactionReport">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total Deposits" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedTotalDeposits, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource SuccessBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total Withdrawals" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedTotalWithdrawals, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource ErrorBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Net Position" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedNetAmount, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource PrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ListView ItemsSource="{x:Bind Items, Mode=OneTime}" SelectionMode="None" MinWidth="850">
                            <ListView.Header>
                                <Grid Padding="16,12" Background="{ThemeResource SecondaryBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Date" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Borrower #" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Borrower Name" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Type" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Amount" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="Balance After" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="Description" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:TransactionReportItem">
                                    <Grid Padding="16,10" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,0.5" MinHeight="38" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind FormattedDate, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind BorrowerNumber}" FontSize="13" Foreground="{ThemeResource PrimaryBrush}" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind BorrowerName}" FontSize="13" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind Type}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind FormattedAmount, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind FormattedBalanceAfter, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind Description, Converter={StaticResource TextToLocalizedTextConverter}}" FontSize="13" Foreground="{ThemeResource SubtleForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Interest Report Template -->
        <DataTemplate x:Key="InterestReportTemplate" x:DataType="models:InterestReport">
            <StackPanel Spacing="16">
                <Border Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Total Accrued Interest" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                        <TextBlock Text="{x:Bind FormattedTotalInterest, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource WarningBrush}" />
                    </StackPanel>
                </Border>

                <Border Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ListView ItemsSource="{x:Bind Segments, Mode=OneTime}" SelectionMode="None" MinWidth="850">
                            <ListView.Header>
                                <Grid Padding="16,12" Background="{ThemeResource SecondaryBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Start Date" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="End Date" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Borrower" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Opening Principal" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Rate %" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="Days" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="Interest Accrued" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="7" Text="Closing Principal" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:InterestReportSegment">
                                    <Grid Padding="16,10" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,0.5" MinHeight="38" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind FormattedStartDate, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind FormattedEndDate, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind BorrowerName}" FontSize="13" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind FormattedOpeningPrincipal, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind FormattedRate, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind FormattedDays, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind FormattedInterest, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" Foreground="{ThemeResource WarningBrush}" />
                                        <TextBlock Grid.Column="7" Text="{x:Bind FormattedClosingPrincipal, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" FontWeight="SemiBold" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Outstanding Report Template -->
        <DataTemplate x:Key="OutstandingReportTemplate" x:DataType="models:OutstandingReport">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total Principal" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedTotalPrincipal, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total Accrued Interest" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedTotalInterest, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource WarningBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Grand Total Outstanding" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedTotalOutstanding, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource ErrorBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ListView ItemsSource="{x:Bind Items, Mode=OneTime}" SelectionMode="None" MinWidth="850">
                            <ListView.Header>
                                <Grid Padding="16,12" Background="{ThemeResource SecondaryBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Borrower #" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Borrower Name" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Contact" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Principal" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Accrued Interest" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="Total Outstanding" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="Status" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="7" Text="Last Activity" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:OutstandingReportItem">
                                    <Grid Padding="16,10" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,0.5" MinHeight="38" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="160" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind BorrowerNumber, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" Foreground="{ThemeResource PrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind BorrowerName}" FontSize="13" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind Contact, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind FormattedPrincipal, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind FormattedAccumulatedInterest, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" Foreground="{ThemeResource WarningBrush}" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind FormattedOutstanding, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource ErrorBrush}" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind Status}" FontSize="13" />
                                        <TextBlock Grid.Column="7" Text="{x:Bind FormattedLastActivityDate, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Borrower Summary Template -->
        <DataTemplate x:Key="BorrowerSummaryTemplate" x:DataType="models:BorrowerSummaryReport">
            <StackPanel Spacing="16">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total Borrowed" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedTotalWithdrawals, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource ErrorBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total Deposited" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedTotalDeposits, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource SuccessBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total Interest" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedTotalInterest, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource WarningBrush}" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Total Outstanding" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                            <TextBlock Text="{x:Bind FormattedTotalOutstanding, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="20" FontWeight="Bold" Foreground="{ThemeResource PrimaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ListView ItemsSource="{x:Bind Items, Mode=OneTime}" SelectionMode="None" MinWidth="850">
                            <ListView.Header>
                                <Grid Padding="16,12" Background="{ThemeResource SecondaryBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" MinWidth="120" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Borrower #" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Borrower Name" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Borrowed" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Deposited" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="4" Text="Interest" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="5" Text="Current Bal" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="6" Text="Total Outstanding" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="7" Text="Status" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                            </ListView.Header>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:BorrowerSummaryItem">
                                    <Grid Padding="16,10" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,0,0,0.5" MinHeight="38" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="*" MinWidth="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{x:Bind BorrowerNumber}" FontSize="13" Foreground="{ThemeResource PrimaryBrush}" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind BorrowerName}" FontSize="13" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind FormattedTotalWithdrawn, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" />
                                        <TextBlock Grid.Column="3" Text="{x:Bind FormattedTotalDeposited, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" />
                                        <TextBlock Grid.Column="4" Text="{x:Bind FormattedTotalInterest, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" Foreground="{ThemeResource WarningBrush}" />
                                        <TextBlock Grid.Column="5" Text="{x:Bind FormattedCurrentBalance, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" />
                                        <TextBlock Grid.Column="6" Text="{x:Bind FormattedTotalOutstanding, Converter={StaticResource DigitLocalizingConverter}}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource ErrorBrush}" />
                                        <TextBlock Grid.Column="7" Text="{x:Bind Status}" FontSize="13" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </DataTemplate>

        <local:ReportTemplateSelector
            x:Key="ReportTemplateSelector"
            BorrowerStatementTemplate="{StaticResource BorrowerStatementTemplate}"
            TransactionReportTemplate="{StaticResource TransactionReportTemplate}"
            InterestReportTemplate="{StaticResource InterestReportTemplate}"
            OutstandingReportTemplate="{StaticResource OutstandingReportTemplate}"
            BorrowerSummaryTemplate="{StaticResource BorrowerSummaryTemplate}" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Row -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource SubtleForegroundBrush}" />
                </StackPanel>
                <Button Grid.Column="1" Height="36" Padding="14,0" CornerRadius="6" Style="{StaticResource SecondaryButtonStyle}" Command="{x:Bind ViewModel.RefreshCommand, Mode=OneWay}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        <TextBlock Text="{x:Bind ViewModel.RefreshText, Mode=OneWay}" FontSize="13" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Filter Controls Bar -->
            <Border Grid.Row="1" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,14">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Grid ColumnSpacing="12" RowSpacing="8" MinWidth="850">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Report Type Selector -->
                        <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind ViewModel.ReportTypeLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.ReportTypeOptions, Mode=OneWay}"
                                      SelectedValue="{x:Bind ViewModel.SelectedReportType, Mode=TwoWay}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      MinWidth="170" Height="38" VerticalAlignment="Bottom" />
                        </StackPanel>

                        <!-- Searchable Borrower Input -->
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Bottom"
                                    Visibility="{x:Bind ViewModel.SelectedReportType, Mode=OneWay, Converter={StaticResource BorrowerFilterVisibilityConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.BorrowerLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Bottom">
                                <AutoSuggestBox x:Name="BorrowerSearchBox"
                                                PlaceholderText="{x:Bind ViewModel.SearchBorrowerPlaceholder, Mode=OneWay}"
                                                Text="{x:Bind ViewModel.SearchQueryText, Mode=OneWay}"
                                                ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}"
                                                TextMemberPath="FullName"
                                                MinWidth="240" MaxWidth="320" Height="38"
                                                VerticalAlignment="Bottom">
                                    <AutoSuggestBox.ItemTemplate>
                                        <DataTemplate x:DataType="appModels:BorrowerSummary">
                                            <StackPanel Padding="4,4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{x:Bind FullName, Mode=OneTime}" FontWeight="SemiBold" FontSize="13" />
                                                    <TextBlock Text="{x:Bind BorrowerNumber, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" Foreground="{ThemeResource PrimaryBrush}" FontSize="12" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{x:Bind Contact, Mode=OneTime, Converter={StaticResource DigitLocalizingConverter}}" FontSize="11.5" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </AutoSuggestBox.ItemTemplate>
                                </AutoSuggestBox>
                                <Button Command="{x:Bind ViewModel.ClearBorrowerCommand, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.HasSelectedBorrower, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.ClearText, Mode=OneWay}"
                                        Style="{StaticResource IconOnlyButtonStyle}"
                                        Height="38" Width="34" CornerRadius="6" VerticalAlignment="Bottom">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- From Date Picker -->
                        <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind ViewModel.FromLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                            <CalendarDatePicker helpers:DatePickerLocalization.IsEnabled="True"
                                                Date="{x:Bind ViewModel.FromDate, Mode=TwoWay}"
                                                MinWidth="140" Height="38" VerticalAlignment="Bottom" />
                        </StackPanel>

                        <!-- To Date Picker -->
                        <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Bottom">
                            <TextBlock Text="{x:Bind ViewModel.ToLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                            <CalendarDatePicker helpers:DatePickerLocalization.IsEnabled="True"
                                                Date="{x:Bind ViewModel.ToDate, Mode=TwoWay}"
                                                MinWidth="140" Height="38" VerticalAlignment="Bottom" />
                        </StackPanel>

                        <!-- Transaction Type Filter (Visible only for TransactionReport) -->
                        <StackPanel Grid.Column="4" Spacing="6" VerticalAlignment="Bottom"
                                    Visibility="{x:Bind ViewModel.SelectedReportType, Mode=OneWay, Converter={StaticResource TransactionFilterVisibilityConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.TransactionTypeLabel, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" />
                            <ComboBox ItemsSource="{x:Bind ViewModel.TransactionTypeFilterOptions, Mode=OneWay}"
                                      SelectedValue="{x:Bind ViewModel.TransactionTypeFilter, Mode=TwoWay}"
                                      SelectedValuePath="Value" DisplayMemberPath="Label"
                                      MinWidth="120" Height="38" VerticalAlignment="Bottom" />
                        </StackPanel>

                        <!-- Empty filler column -->
                        <Grid Grid.Column="5" />

                        <!-- Action Buttons -->
                        <Button Grid.Column="6" Height="38" Padding="18,0" CornerRadius="6"
                                Content="{x:Bind ViewModel.GenerateReportText, Mode=OneWay}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{x:Bind ViewModel.GenerateCommand, Mode=OneWay}"
                                VerticalAlignment="Bottom" />

                        <Button Grid.Column="7" Height="38" Padding="16,0" CornerRadius="6"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{x:Bind ViewModel.ExportPdfCommand, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanExport, Mode=OneWay}"
                                VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                <TextBlock Text="{x:Bind ViewModel.ExportPdfLabel, Mode=OneWay}" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Loading Indicator -->
            <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel Spacing="8" HorizontalAlignment="Center" Margin="0,32">
                    <ProgressRing IsActive="True" Style="{StaticResource LoadingIndicatorStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.GeneratingReportLabel, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" />
                </StackPanel>
            </Grid>

            <!-- Error Notification Banner -->
            <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" HorizontalAlignment="Center">
                    <StackPanel Spacing="12" HorizontalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" Foreground="{ThemeResource ErrorBrush}" />
                        <Button Content="{x:Bind ViewModel.RetryText, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" Command="{x:Bind ViewModel.RetryCommand, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Generated Report Content Area -->
            <Grid Grid.Row="3" Visibility="{x:Bind ViewModel.HasReport, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <ContentControl Content="{x:Bind ViewModel.CurrentReport, Mode=OneWay}" ContentTemplateSelector="{StaticResource ReportTemplateSelector}" HorizontalContentAlignment="Stretch" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>

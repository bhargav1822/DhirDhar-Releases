<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DhirDhar.Desktop.Views.Placeholder.FeaturePlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationBackgroundBrush}">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="{x:Bind FeatureTitle, Mode=OneTime}"
                   Style="{StaticResource HeadingTextStyle}"
                   Margin="0,0,0,16" />

        <StackPanel Grid.Row="1" Spacing="8">
            <TextBlock x:Name="ComingSoonText" Text="" Style="{StaticResource BodyTextStyle}" />
            <TextBlock x:Name="FoundationReadyText" Text="" Style="{StaticResource SubtleTextStyle}" />
        </StackPanel>
    </Grid>
</Page>

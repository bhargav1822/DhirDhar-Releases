<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DhirDhar.Desktop.Views.Dashboard.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DhirDhar.Desktop.Converters"
    xmlns:models="using:DhirDhar.Application.Search.Models"
    xmlns:helpers="using:DhirDhar.Desktop.Helpers"
    xmlns:controls="using:DhirDhar.Desktop.Controls"
    Background="{ThemeResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
         <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <converters:DigitLocalizingConverter x:Key="DigitLocalizingConverter" />
        <converters:DateTimeFormatConverter x:Key="DateTimeFormatConverter" />
        <converters:TextToLocalizedTextConverter x:Key="TextToLocalizedTextConverter" />

        <ControlTemplate x:Key="CardButtonTemplate" TargetType="Button">
            <Grid x:Name="RootGrid" Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource PrimaryBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="CardBorder.BorderBrush" Value="{ThemeResource PrimaryBrush}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled" />
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border x:Name="CardBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </Grid>
        </ControlTemplate>

        <Style x:Key="CardButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template" Value="{StaticResource CardButtonTemplate}" />
        </Style>

        <Style x:Key="CardPadding20ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SurfaceBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template" Value="{StaticResource CardButtonTemplate}" />
        </Style>

        <Style x:Key="MonthSelectorComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{ThemeResource ApplicationBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="32" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="DashboardScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <Grid x:Name="DashboardRootGrid" Padding="32,32,32,40" RowSpacing="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="LayoutStates">
                        <VisualState x:Name="WideLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="1200" />
                            </VisualState.StateTriggers>
                        </VisualState>
                        <VisualState x:Name="NarrowLayout">
                            <VisualState.StateTriggers>
                                <AdaptiveTrigger MinWindowWidth="0" />
                            </VisualState.StateTriggers>
                            <VisualState.Setters>
                                <Setter Target="KpiRowGrid.RowSpacing" Value="16" />
                                <Setter Target="TotalBorrowersKpiButton.(Grid.Row)" Value="0" />
                                <Setter Target="TotalBorrowersKpiButton.(Grid.Column)" Value="0" />
                                <Setter Target="TotalBorrowersKpiButton.(Grid.ColumnSpan)" Value="5" />
                                <Setter Target="OutstandingKpiButton.(Grid.Row)" Value="0" />
                                <Setter Target="OutstandingKpiButton.(Grid.Column)" Value="5" />
                                <Setter Target="OutstandingKpiButton.(Grid.ColumnSpan)" Value="5" />
                                <Setter Target="DepositsKpiButton.(Grid.Row)" Value="1" />
                                <Setter Target="DepositsKpiButton.(Grid.Column)" Value="0" />
                                <Setter Target="DepositsKpiButton.(Grid.ColumnSpan)" Value="5" />
                                <Setter Target="WithdrawalsKpiButton.(Grid.Row)" Value="1" />
                                <Setter Target="WithdrawalsKpiButton.(Grid.Column)" Value="5" />
                                <Setter Target="WithdrawalsKpiButton.(Grid.ColumnSpan)" Value="5" />
                                <Setter Target="InterestKpiButton.(Grid.Row)" Value="2" />
                                <Setter Target="InterestKpiButton.(Grid.Column)" Value="0" />
                                <Setter Target="InterestKpiButton.(Grid.ColumnSpan)" Value="10" />
                                <Setter Target="QuickActionsRowGrid.RowSpacing" Value="12" />
                                <Setter Target="AddBorrowerQuickButton.(Grid.Row)" Value="0" />
                                <Setter Target="AddBorrowerQuickButton.(Grid.Column)" Value="0" />
                                <Setter Target="AddBorrowerQuickButton.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="ReceivePaymentQuickButton.(Grid.Row)" Value="0" />
                                <Setter Target="ReceivePaymentQuickButton.(Grid.Column)" Value="2" />
                                <Setter Target="ReceivePaymentQuickButton.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="GivePaymentQuickButton.(Grid.Row)" Value="1" />
                                <Setter Target="GivePaymentQuickButton.(Grid.Column)" Value="0" />
                                <Setter Target="GivePaymentQuickButton.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="GenerateReportQuickButton.(Grid.Row)" Value="1" />
                                <Setter Target="GenerateReportQuickButton.(Grid.Column)" Value="2" />
                                <Setter Target="GenerateReportQuickButton.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="MainContentRowGrid.RowSpacing" Value="16" />
                                <Setter Target="OutstandingCard.(Grid.Row)" Value="0" />
                                <Setter Target="OutstandingCard.(Grid.Column)" Value="0" />
                                <Setter Target="OutstandingCard.(Grid.ColumnSpan)" Value="2" />
                                <Setter Target="RecentCard.(Grid.Row)" Value="1" />
                                <Setter Target="RecentCard.(Grid.Column)" Value="0" />
                                <Setter Target="RecentCard.(Grid.ColumnSpan)" Value="2" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <!-- Dashboard Header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle, Mode=OneWay}" FontSize="31" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PageSubtitle, Mode=OneWay}" FontSize="14" Foreground="{ThemeResource SubtleForegroundBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <!-- Search Section -->
                        <Grid VerticalAlignment="Center">
                            <!-- Normal State: Search Icon Button -->
                            <Button x:Name="SearchIconButton"
                                    Width="40"
                                    Height="40"
                                    CornerRadius="8"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnSearchIconClick"
                                    Visibility="{Binding IsSearchExpanded, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                    AutomationProperties.Name="{Binding SearchLabel, Mode=OneWay}"
                                    ToolTipService.ToolTip="{Binding SearchLabel, Mode=OneWay}">
                                <FontIcon Glyph="&#xE721;" FontSize="20" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>

                            <!-- Expanded State: Inline Search Bar Container -->
                            <Grid x:Name="SearchBarContainer"
                                  MinWidth="240"
                                  MaxWidth="380"
                                  Height="40"
                                  HorizontalAlignment="Stretch"
                                  Visibility="{Binding IsSearchExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <controls:DhirDharPhoneticTextBox x:Name="HeaderSearchTextBox"
                                         FieldType="SearchText"
                                         MinWidth="240"
                                         MaxWidth="380"
                                         HorizontalAlignment="Stretch"
                                         Height="40"
                                         CornerRadius="8"
                                         PlaceholderText="{Binding SearchPlaceholder, Mode=OneWay}"
                                         TextChanged="OnSearchTextBoxTextChanged"
                                         KeyDown="OnSearchTextBoxKeyDown"
                                         Padding="12,8,40,8"
                                         VerticalContentAlignment="Center"
                                         Background="{ThemeResource SurfaceBackgroundBrush}"
                                         BorderBrush="{ThemeResource BorderBrush}"
                                         BorderThickness="1" />

                                <Button x:Name="CloseSearchButton"
                                        Width="32"
                                        Height="32"
                                        CornerRadius="16"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Margin="0,0,4,0"
                                        Click="OnCloseSearchClick"
                                        AutomationProperties.Name="{Binding CloseSearchLabel, Mode=OneWay}"
                                        ToolTipService.ToolTip="{Binding CloseSearchToolTipLabel, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Button>

                                <Popup x:Name="SearchResultsPopup"
                                       IsOpen="{Binding IsSearchPopupOpen, Mode=OneWay}"
                                       IsLightDismissEnabled="False"
                                       ShouldConstrainToRootBounds="True"
                                       VerticalOffset="46">
                                    <Border MinWidth="260"
                                            MaxWidth="380"
                                            MaxHeight="320"
                                            Background="{ThemeResource SurfaceBackgroundBrush}"
                                            BorderBrush="{ThemeResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="8">
                                        <Grid>
                                            <ProgressRing IsActive="{Binding IsSearching, Mode=OneWay}"
                                                          Visibility="{Binding IsSearching, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Margin="16" />

                                            <TextBlock Text="{Binding NoBorrowerFoundLabel, Mode=OneWay}"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource SubtleForegroundBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Margin="16"
                                                       Visibility="{Binding HasNoSearchResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <ListView ItemsSource="{Binding SearchResults, Mode=OneWay}"
                                                      Visibility="{Binding HasSearchResults, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      SelectionMode="Single"
                                                      ItemClick="OnSearchResultItemClick"
                                                      IsItemClickEnabled="True">
                                                <ListView.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Padding="8,6" ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="6" Background="{ThemeResource PrimaryBrush}" Opacity="0.12" VerticalAlignment="Center">
                                                                <FontIcon Glyph="&#xE716;" FontSize="14" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                 <StackPanel Orientation="Horizontal" Spacing="4">
                                                                     <TextBlock Text="{Binding EntityType, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                                                     <TextBlock Text="•" FontSize="11" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                                                     <TextBlock Text="{Binding Subtitle, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                                                 </StackPanel>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="{Binding Status, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ListView.ItemTemplate>
                                            </ListView>
                                        </Grid>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Grid>

                        <!-- QR Search Button (Immediately beside magnifying-glass search) -->
                        <Button x:Name="QrSearchIconButton"
                                Width="40"
                                Height="40"
                                CornerRadius="8"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnQrSearchClick"
                                AutomationProperties.Name="{Binding ScanQrLabel, Mode=OneWay}"
                                ToolTipService.ToolTip="{Binding ScanQrLabel, Mode=OneWay}">
                            <FontIcon Glyph="&#xED14;" FontSize="20" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>

                        <!-- Live Clock -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE823;" FontSize="20" Foreground="{ThemeResource PrimaryBrush}" />
                            <StackPanel VerticalAlignment="Center" Spacing="0">
                                <TextBlock Text="{Binding ClockText, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ClockDateText, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Software Update Notification Bell Icon (Conditionally Visible, Zero Layout Reservation when Hidden) -->
                        <Button x:Name="UpdateNotificationBellButton"
                                Width="40" Height="40" Padding="0" CornerRadius="20"
                                Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                ToolTipService.ToolTip="New DhirDhar Update Available"
                                AutomationProperties.Name="Software Update Notification">
                            <Grid Width="40" Height="40">
                                <!-- Bell Icon (Segoe MDL2 / Fluent Icons Ringer: &#xEA8F;) -->
                                <FontIcon Glyph="&#xEA8F;" FontSize="20" Foreground="{ThemeResource ApplicationForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                
                                <!-- Small Notification Badge Indicator (Red Dot) -->
                                <Ellipse Width="10" Height="10" Fill="#EF4444" Stroke="{ThemeResource SurfaceBackgroundBrush}" StrokeThickness="2"
                                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0" />
                            </Grid>

                            <Button.Flyout>
                                <Flyout x:Name="UpdateNotificationFlyout" Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="300" Padding="16" Spacing="12">
                                        <!-- Header with Bell Icon -->
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="{ThemeResource PrimaryBrush}" Opacity="0.15">
                                                <FontIcon Glyph="&#xEA8F;" FontSize="18" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="New DhirDhar Update Available" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding UpdateBadgeSubtitle, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource PrimaryBrush}" FontWeight="SemiBold" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource BorderBrush}" />

                                        <!-- Version Details -->
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="{Binding AvailableUpdateText, Mode=OneWay}" FontSize="13" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CurrentVersionText, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- Action Buttons: Later & View Update -->
                                        <Grid ColumnSpacing="8" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Later" Click="OnDismissUpdateFlyoutClick"
                                                    HorizontalAlignment="Stretch" Height="34" CornerRadius="6"
                                                    Style="{StaticResource SecondaryButtonStyle}" />
                                            <Button Grid.Column="1" Content="View Update" Command="{Binding ViewUpdateCommand, Mode=OneWay}"
                                                    Click="OnDismissUpdateFlyoutClick"
                                                    HorizontalAlignment="Stretch" Height="34" CornerRadius="6"
                                                    Style="{StaticResource PrimaryButtonStyle}" />
                                        </Grid>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <!-- User Profile Avatar with Interactive Menu Flyout -->
                        <Button Width="50" Height="50" Padding="0" CornerRadius="25"
                                Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                ToolTipService.ToolTip="{Binding UserProfileLabel, Mode=OneWay}">
                            <Grid Width="50" Height="50">
                                <Ellipse Fill="{ThemeResource PrimaryBrush}" Width="50" Height="50" />
                                <FontIcon Glyph="&#xE77B;" FontSize="24" Foreground="{ThemeResource PrimaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight">
                                    <StackPanel Width="280" Spacing="0">
                                        <!-- Header Info Section -->
                                        <Grid Padding="16,16,16,12" ColumnSpacing="12" Background="{ThemeResource ApplicationBackgroundBrush}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Grid.Column="0" Width="48" Height="48">
                                                <Ellipse Fill="{ThemeResource PrimaryBrush}" Width="48" Height="48" />
                                                <FontIcon Glyph="&#xE77B;" FontSize="22" Foreground="{ThemeResource PrimaryForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="{Binding ProfileDisplayName, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding ProfileRoleLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{ThemeResource BorderBrush}" />

                                        <!-- Menu Actions List -->
                                        <StackPanel Padding="8" Spacing="4">
                                            <!-- Account / User Settings -->
                                            <Button Command="{Binding NavigateToSettingsCommand, Mode=OneWay}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding AccountSettingsLabel, Mode=OneWay}" FontSize="13" VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>

                                            <!-- Change Password -->
                                            <Button Command="{Binding NavigateToSettingsCommand, Mode=OneWay}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6"
                                                    ToolTipService.ToolTip="{Binding ChangePasswordLabel, Mode=OneWay}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE8D7;" FontSize="16" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ChangePasswordLabel, Mode=OneWay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Button>

                                            <!-- Logout -->
                                            <Button Command="{Binding NavigateToSettingsCommand, Mode=OneWay}"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6"
                                                    ToolTipService.ToolTip="{Binding LogoutLabel, Mode=OneWay}">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xF3B1;" FontSize="16" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding LogoutLabel, Mode=OneWay}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Dashboard Content Area -->
                <Grid Grid.Row="1">
<!-- Loading Indicator -->
                    <ProgressRing HorizontalAlignment="Center" VerticalAlignment="Center" IsActive="{Binding IsLoading, Mode=OneWay}" Visibility="{Binding IsLoading, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Cards + Error -->
                    <Grid RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Error Banner -->
                        <Grid Grid.Row="0" Margin="0,0,0,16" Visibility="{Binding HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.Background><SolidColorBrush Color="{ThemeResource ErrorColor}" Opacity="0.1" /></Grid.Background>
                            <Grid Padding="16" CornerRadius="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEA39;" Foreground="{ThemeResource ErrorBrush}" FontSize="20" />
                                    <TextBlock Text="{Binding ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource ErrorBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="{Binding RetryLabel, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding RetryCommand, Mode=OneWay}" AutomationProperties.Name="{Binding RetryLabel, Mode=OneWay}" />
                            </Grid>
                        </Grid>

                        <!-- All Dashboard Cards -->
                        <Grid Grid.Row="1" RowSpacing="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- KPI Cards Row: 5 Financial & Summary Tiles -->
                            <Grid x:Name="KpiRowGrid" Grid.Row="0" ColumnSpacing="16" RowSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Tile 1: Total Borrowers -->
                                <Button x:Name="TotalBorrowersKpiButton" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0" Style="{StaticResource CardButtonStyle}" Command="{Binding NavigateToBorrowersCommand, Mode=OneWay}" AutomationProperties.Name="{Binding TotalBorrowersLabel, Mode=OneWay}">
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Border Width="46" Height="46" CornerRadius="12" Background="{ThemeResource PrimaryBrush}" Opacity="0.15" HorizontalAlignment="Left" />
                                            <FontIcon Glyph="&#xE716;" Foreground="{ThemeResource PrimaryBrush}" FontSize="22" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Spacing="2">
                                            <TextBlock Text="{Binding TotalBorrowersLabel, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                            <TextBlock Text="{Binding TotalBorrowers, Mode=OneWay, Converter={StaticResource DigitLocalizingConverter}}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource ApplicationForegroundBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding ActiveLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                            <TextBlock Text="{Binding ActiveBorrowers, Mode=OneWay, Converter={StaticResource DigitLocalizingConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" />
                                            <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" Margin="2,0" />
                                            <TextBlock Text="{Binding ClosedLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                            <TextBlock Text="{Binding ClosedBorrowers, Mode=OneWay, Converter={StaticResource DigitLocalizingConverter}}" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Tile 2: Total Outstanding -->
                                <Button x:Name="OutstandingKpiButton" Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="0" Style="{StaticResource CardButtonStyle}" Command="{Binding NavigateToLedgerCommand, Mode=OneWay}" AutomationProperties.Name="{Binding TotalOutstandingLabel, Mode=OneWay}">
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Border Width="46" Height="46" CornerRadius="12" Background="{ThemeResource SuccessBrush}" Opacity="0.15" HorizontalAlignment="Left" />
                                            <FontIcon Glyph="&#xE8A1;" Foreground="{ThemeResource SuccessBrush}" FontSize="22" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Spacing="2">
                                            <TextBlock Text="{Binding TotalOutstandingLabel, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                            <TextBlock Text="{Binding FormattedOutstandingAmount, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource SuccessBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding CurrentBalanceLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Tile 3: Total Deposits -->
                                <Button x:Name="DepositsKpiButton" Grid.Column="4" Grid.ColumnSpan="2" Grid.Row="0" Style="{StaticResource CardButtonStyle}" Command="{Binding NavigateToDepositsCommand, Mode=OneWay}" AutomationProperties.Name="{Binding TotalDepositsLabel, Mode=OneWay}">
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Border Width="46" Height="46" CornerRadius="12" Background="{ThemeResource SuccessBrush}" Opacity="0.15" HorizontalAlignment="Left" />
                                            <FontIcon Glyph="&#xE896;" Foreground="{ThemeResource SuccessBrush}" FontSize="22" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Spacing="2">
                                            <TextBlock Text="{Binding TotalDepositsLabel, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                            <TextBlock Text="{Binding FormattedTotalDeposits, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource SuccessBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding CumulativeReceivedLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Tile 4: Total Withdrawals -->
                                <Button x:Name="WithdrawalsKpiButton" Grid.Column="6" Grid.ColumnSpan="2" Grid.Row="0" Style="{StaticResource CardButtonStyle}" Command="{Binding NavigateToWithdrawalsCommand, Mode=OneWay}" AutomationProperties.Name="{Binding TotalWithdrawalsLabel, Mode=OneWay}">
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Border Width="46" Height="46" CornerRadius="12" Background="{ThemeResource ErrorBrush}" Opacity="0.15" HorizontalAlignment="Left" />
                                            <FontIcon Glyph="&#xE898;" Foreground="{ThemeResource ErrorBrush}" FontSize="22" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Spacing="2">
                                            <TextBlock Text="{Binding TotalWithdrawalsLabel, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                            <TextBlock Text="{Binding FormattedTotalWithdrawals, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource ErrorBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding CumulativeDisbursedLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <!-- Tile 5: Interest Earned -->
                                <Button x:Name="InterestKpiButton" Grid.Column="8" Grid.ColumnSpan="2" Grid.Row="0" Style="{StaticResource CardButtonStyle}" Command="{Binding NavigateToInterestCommand, Mode=OneWay}" AutomationProperties.Name="{Binding InterestEarnedLabel, Mode=OneWay}">
                                    <Grid RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Border Width="46" Height="46" CornerRadius="12" Background="{ThemeResource PrimaryBrush}" Opacity="0.15" HorizontalAlignment="Left" />
                                            <FontIcon Glyph="&#xE9D2;" Foreground="{ThemeResource PrimaryBrush}" FontSize="22" HorizontalAlignment="Left" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Row="1" Spacing="2">
                                            <TextBlock Text="{Binding InterestEarnedLabel, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                            <TextBlock Text="{Binding FormattedTotalInterest, Mode=OneWay}" FontSize="22" FontWeight="Bold" Foreground="{ThemeResource PrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding TotalAccruedLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- Quick Actions Row: 4 Equal-Width Action Buttons in Single Horizontal Row -->
                            <Grid x:Name="QuickActionsRowGrid" Grid.Row="1" ColumnSpacing="16" RowSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Action 1: Add Borrower -->
                                <Button x:Name="AddBorrowerQuickButton" Grid.Column="0" Height="58" CornerRadius="12"
                                        Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,0"
                                        Command="{Binding AddBorrowerCommand, Mode=OneWay}"
                                        AutomationProperties.Name="{Binding AddBorrowerLabel, Mode=OneWay}">
                                    <Grid ColumnSpacing="14" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Center">
                                            <Border CornerRadius="10" Background="{ThemeResource PrimaryBrush}" Opacity="0.12" />
                                            <FontIcon Glyph="&#xE710;" FontSize="18" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding AddBorrowerLabel, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <!-- Action 2: Receive Payment -->
                                <Button x:Name="ReceivePaymentQuickButton" Grid.Column="1" Height="58" CornerRadius="12"
                                        Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,0"
                                        Command="{Binding ReceivePaymentCommand, Mode=OneWay}"
                                        AutomationProperties.Name="{Binding ReceivePaymentLabel, Mode=OneWay}">
                                    <Grid ColumnSpacing="14" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Center">
                                            <Border CornerRadius="10" Background="{ThemeResource SuccessBrush}" Opacity="0.12" />
                                            <FontIcon Glyph="&#xE896;" FontSize="18" Foreground="{ThemeResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding ReceivePaymentLabel, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <!-- Action 3: Give Payment -->
                                <Button x:Name="GivePaymentQuickButton" Grid.Column="2" Height="58" CornerRadius="12"
                                        Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,0"
                                        Command="{Binding GivePaymentCommand, Mode=OneWay}"
                                        AutomationProperties.Name="{Binding GivePaymentLabel, Mode=OneWay}">
                                    <Grid ColumnSpacing="14" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Center">
                                            <Border CornerRadius="10" Background="{ThemeResource WarningBrush}" Opacity="0.12" />
                                            <FontIcon Glyph="&#xE898;" FontSize="18" Foreground="{ThemeResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding GivePaymentLabel, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>

                                <!-- Action 4: Generate Report -->
                                <Button x:Name="GenerateReportQuickButton" Grid.Column="3" Height="58" CornerRadius="12"
                                        Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,0"
                                        Command="{Binding GenerateReportCommand, Mode=OneWay}"
                                        AutomationProperties.Name="{Binding GenerateReportLabel, Mode=OneWay}">
                                    <Grid ColumnSpacing="14" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="38" Height="38" VerticalAlignment="Center">
                                            <Border CornerRadius="10" Background="{ThemeResource PrimaryBrush}" Opacity="0.12" />
                                            <FontIcon Glyph="&#xE9F9;" FontSize="18" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding GenerateReportLabel, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource ApplicationForegroundBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </Grid>

                            <!-- Main Content Row: Outstanding Overview + Recent Transactions -->
                            <Grid x:Name="MainContentRowGrid" Grid.Row="2" ColumnSpacing="16" RowSpacing="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="11*" />
                                    <ColumnDefinition Width="9*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Left Card: Outstanding Overview -->
                                <Border x:Name="OutstandingCard" Grid.Column="0" Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="12" Padding="20" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                    <Grid RowSpacing="14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Card Header: Title & Info Icon on Left, Single Year Selector on Right -->
                                        <Grid Grid.Row="0">
                                            <Button Command="{Binding NavigateToLedgerCommand, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE9D2;" Foreground="{ThemeResource PrimaryBrush}" FontSize="18" />
                                                    <TextBlock Text="{Binding OutstandingOverviewLabel, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <FontIcon Glyph="&#xE946;" Foreground="{ThemeResource SubtleForegroundBrush}" FontSize="16" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding OutstandingOverviewLabel, Mode=OneWay}" />
                                                </StackPanel>
                                            </Button>
                                            <ComboBox x:Name="YearSelector"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource MonthSelectorComboBoxStyle}"
                                                      ItemsSource="{Binding YearOptions, Mode=OneWay}"
                                                      SelectedItem="{Binding SelectedYearOption, Mode=TwoWay}"
                                                      AutomationProperties.Name="Year Selection">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Label, Mode=OneWay}" FontSize="13" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </Grid>

                                        <!-- Compact Color Legend -->
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" Margin="0,-4,0,2">
                                            <!-- 1. New Loans (Orange) -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="10" Height="10" CornerRadius="2" Background="#F59E0B" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding NewLoansLegendLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- 2. Withdrawals (Red) -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="10" Height="10" CornerRadius="2" Background="#EF4444" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding WithdrawalsLegendLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- 3. Deposits (Green) -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="10" Height="10" CornerRadius="2" Background="#10B981" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding DepositsLegendLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <!-- 4. Interest Earned (Blue) -->
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Width="10" Height="10" CornerRadius="2" Background="#3B82F6" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding InterestEarnedLegendLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- 12-Month 4-Bar Grouped Chart Area with Dynamic Y-Axis -->
                                        <Grid Grid.Row="2" Height="175" Visibility="{Binding HasYearlyChartData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="48" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Y-Axis Dynamic Tick Labels (Left) -->
                                            <Grid Grid.Column="0" Height="140" VerticalAlignment="Top">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding YAxisMaxLabel, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,8,0" />
                                                <TextBlock Grid.Row="1" Text="{Binding YAxis75Label, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,8,0" />
                                                <TextBlock Grid.Row="2" Text="{Binding YAxis50Label, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,8,0" />
                                                <TextBlock Grid.Row="3" Text="{Binding YAxis25Label, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,8,0" />
                                                <TextBlock Grid.Row="4" Text="{Binding YAxisMinLabel, Mode=OneWay}" FontSize="10" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,0" />
                                            </Grid>

                                            <!-- Plot Area with Horizontal Gridlines & 12 Month Bar Groups (Right) -->
                                            <Grid Grid.Column="1" Height="175" VerticalAlignment="Top">
                                                <!-- Background Horizontal Gridlines -->
                                                <Grid Height="140" VerticalAlignment="Top">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="*" />
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="0" Height="1" Background="{ThemeResource BorderBrush}" Opacity="0.3" VerticalAlignment="Top" />
                                                    <Border Grid.Row="1" Height="1" Background="{ThemeResource BorderBrush}" Opacity="0.3" VerticalAlignment="Top" />
                                                    <Border Grid.Row="2" Height="1" Background="{ThemeResource BorderBrush}" Opacity="0.3" VerticalAlignment="Top" />
                                                    <Border Grid.Row="3" Height="1" Background="{ThemeResource BorderBrush}" Opacity="0.3" VerticalAlignment="Top" />
                                                    <Border Grid.Row="3" Height="1" Background="{ThemeResource BorderBrush}" Opacity="0.5" VerticalAlignment="Bottom" />
                                                </Grid>

                                                <!-- 12-Month Grouped Columns -->
                                                <ItemsControl ItemsSource="{Binding MonthlyGroups, Mode=OneWay}" Height="175" VerticalAlignment="Top">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="175" VerticalAlignment="Top" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid VerticalAlignment="Top" Margin="4,0" Width="36">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="140" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <!-- 4 Grouped Vertical Bars for this Month -->
                                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="2" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                                                                    <!-- 1. New Loans (Orange) -->
                                                                    <Border Width="6" Height="{Binding NewLoansBar.BarHeight, Mode=OneWay}" CornerRadius="2,2,0,0" Background="#F59E0B" VerticalAlignment="Bottom" ToolTipService.ToolTip="{Binding NewLoansBar.TooltipText, Mode=OneWay}" />
                                                                    <!-- 2. Withdrawals (Red) -->
                                                                    <Border Width="6" Height="{Binding WithdrawalsBar.BarHeight, Mode=OneWay}" CornerRadius="2,2,0,0" Background="#EF4444" VerticalAlignment="Bottom" ToolTipService.ToolTip="{Binding WithdrawalsBar.TooltipText, Mode=OneWay}" />
                                                                    <!-- 3. Deposits (Green) -->
                                                                    <Border Width="6" Height="{Binding DepositsBar.BarHeight, Mode=OneWay}" CornerRadius="2,2,0,0" Background="#10B981" VerticalAlignment="Bottom" ToolTipService.ToolTip="{Binding DepositsBar.TooltipText, Mode=OneWay}" />
                                                                    <!-- 4. Interest Earned (Blue) -->
                                                                    <Border Width="6" Height="{Binding InterestEarnedBar.BarHeight, Mode=OneWay}" CornerRadius="2,2,0,0" Background="#3B82F6" VerticalAlignment="Bottom" ToolTipService.ToolTip="{Binding InterestEarnedBar.TooltipText, Mode=OneWay}" />
                                                                </StackPanel>

                                                                <!-- Month Label below bars -->
                                                                <TextBlock Grid.Row="1" Text="{Binding MonthLabel, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Grid>

                                        <!-- Empty Chart State (Fallback) -->
                                        <Border Grid.Row="2" Height="175" Background="{ThemeResource ApplicationBackgroundBrush}" CornerRadius="8" Visibility="{Binding HasYearlyChartData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE9D2;" Foreground="{ThemeResource SubtleForegroundBrush}" FontSize="28" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding NoHistoricalDataLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Summary Cards Row Below Chart -->
                                        <Grid Grid.Row="3" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{ThemeResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="12" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding OpeningLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                                    <TextBlock Text="{Binding FormattedOpeningBalance, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource PrimaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="{ThemeResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="12" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding NewLoansLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                                    <TextBlock Text="{Binding FormattedNewLoans, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource ErrorBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="2" Background="{ThemeResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="12" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding PaymentsLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                                    <TextBlock Text="{Binding FormattedPayments, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SuccessBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="3" Background="{ThemeResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="12" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding ClosingLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                                    <TextBlock Text="{Binding FormattedClosingBalance, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource SuccessBrush}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <!-- Right Card: Recent Transactions -->
                                <Border x:Name="RecentCard" Grid.Column="1" Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="12" Padding="20" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1">
                                    <Grid RowSpacing="12">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Card Header -->
                                        <Grid Grid.Row="0">
                                            <Button Command="{Binding NavigateToTransactionsCommand, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE8C7;" Foreground="{ThemeResource PrimaryBrush}" FontSize="18" />
                                                    <TextBlock Text="{Binding RecentTransactionsLabel, Mode=OneWay}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding NavigateToTransactionsCommand, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ViewAllLabel, Mode=OneWay}" FontSize="13" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
                                            </Button>
                                        </Grid>

<!-- Transactions List -->
                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentTransactions, Mode=OneWay}" Visibility="{Binding HasData, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Padding="0,10">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="{ThemeResource ApplicationBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                            <FontIcon Glyph="&#xE8C7;" FontSize="20" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding BorrowerName, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding TransactionType, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                                                <TextBlock Text="{Binding TransactionDate, Mode=OneWay, Converter={StaticResource DateTimeFormatConverter}}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                            <TextBlock Text="₹ " FontSize="14" FontWeight="SemiBold" Foreground="{Binding TransactionTypeKey, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}" />
                                                            <TextBlock Text="{Binding Amount, Mode=OneWay, Converter={StaticResource DigitLocalizingConverter}}" FontSize="14" FontWeight="SemiBold" Foreground="{Binding TransactionTypeKey, Mode=OneWay, Converter={StaticResource StatusToBrushConverter}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Empty State -->
                                        <Border Grid.Row="1" Background="{ThemeResource ApplicationBackgroundBrush}" CornerRadius="8" Padding="24" Visibility="{Binding HasData, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                            <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE8C7;" Foreground="{ThemeResource SubtleForegroundBrush}" FontSize="28" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding NoRecentTransactionsLabel, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                <TextBlock Text="{Binding NoRecentTransactionsDesc, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="1" Height="44" Background="{ThemeResource SurfaceBackgroundBrush}" BorderBrush="{ThemeResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ReadyLabel, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding FormattedApplicationVersion, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,16,0">
                    <FontIcon Glyph="&#xE7C3;" FontSize="14" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FormattedFinancialYear, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource SubtleForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>

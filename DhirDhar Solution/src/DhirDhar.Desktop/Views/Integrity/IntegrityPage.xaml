<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="DhirDhar.Desktop.Views.Integrity.IntegrityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DhirDhar.Desktop.Converters"
    xmlns:viewModels="using:DhirDhar.Desktop.ViewModels"
    Background="{ThemeResource ApplicationBackgroundBrush}">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <converters:TextToLocalizedTextConverter x:Key="TextToLocalizedTextConverter" />
        <converters:DigitLocalizingConverter x:Key="DigitLocalizingConverter" />
        <converters:SeverityToBackgroundBrushConverter x:Key="SeverityToBackgroundBrushConverter" />
        <converters:SeverityToForegroundBrushConverter x:Key="SeverityToForegroundBrushConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Padding="24" RowSpacing="16" MaxWidth="1600" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.PageTitle, Mode=OneWay}" Style="{StaticResource HeadingTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.PageSubtitle, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" Opacity="0.75" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Width="24" Height="24" />
                    <Button Content="{x:Bind ViewModel.RunFullScanLabel, Mode=OneWay}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{x:Bind ViewModel.RunScanCommand, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                </StackPanel>
            </Grid>

            <!-- 2. Status Card -->
            <Border Grid.Row="1" Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.IntegrityStatusLabel, Mode=OneWay}" Style="{StaticResource TitleTextStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 3. Scan Summary Card -->
            <Border Grid.Row="2" Background="{ThemeResource SurfaceBackgroundBrush}" CornerRadius="8" Padding="20">
                <StackPanel Spacing="12">
                    <TextBlock Text="{x:Bind ViewModel.ScanSummaryLabel, Mode=OneWay}" Style="{StaticResource TitleTextStyle}" />
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Bind ViewModel.OverallStatusLabel, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.OverallStatusDisplay, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Bind ViewModel.TotalIssuesLabel, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.ScanReport.TotalIssuesFound, Mode=OneWay, Converter={StaticResource DigitLocalizingConverter}}" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Bind ViewModel.ScannedAtLabel, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ScannedAtDisplay, Mode=OneWay}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 4. Healthy State Card (Visible when scan passes and 0 issues) -->
            <Border Grid.Row="3"
                    Background="{ThemeResource SurfaceBackgroundBrush}"
                    BorderBrush="#22C55E"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20"
                    Visibility="{x:Bind ViewModel.IsHealthy, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0" Glyph="&#xE73E;" FontSize="32" Foreground="#22C55E" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.OverallStatusDisplay, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="#22C55E" />
                        <TextBlock Text="{x:Bind ViewModel.HealthyStateMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 5. Detected Issues List Section (Visible when issues exist) -->
            <StackPanel Grid.Row="4"
                        Spacing="12"
                        Visibility="{x:Bind ViewModel.HasIssues, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                <TextBlock Text="{x:Bind ViewModel.IssueDetailsLabel, Mode=OneWay}" Style="{StaticResource TitleTextStyle}" />
                
                <ItemsControl ItemsSource="{x:Bind ViewModel.Issues, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:IntegrityIssueItemViewModel">
                            <Border Background="{ThemeResource SurfaceBackgroundBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="18"
                                    Margin="0,0,0,12">
                                <Grid RowSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Header: Severity Badge, Title, Borrower Number Pill, Category -->
                                    <Grid Grid.Row="0" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Severity Badge -->
                                        <Border Grid.Column="0"
                                                Background="{x:Bind Severity, Mode=OneWay, Converter={StaticResource SeverityToBackgroundBrushConverter}}"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind SeverityDisplay, Mode=OneWay}"
                                                       Foreground="{x:Bind Severity, Mode=OneWay, Converter={StaticResource SeverityToForegroundBrushConverter}}"
                                                       FontWeight="Bold"
                                                       FontSize="12" />
                                        </Border>

                                        <!-- Title -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{x:Bind Title, Mode=OneWay}"
                                                   FontWeight="SemiBold"
                                                   FontSize="16"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap" />

                                        <!-- Borrower Number Badge (if applicable) -->
                                        <Border Grid.Column="2"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind HasBorrowerNumber, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind BorrowerNumberBadge, Mode=OneWay}"
                                                       FontWeight="SemiBold"
                                                       FontSize="12" />
                                        </Border>

                                        <!-- Category Pill -->
                                        <Border Grid.Column="3"
                                                Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,3"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Category, Mode=OneWay}"
                                                       FontSize="12"
                                                       Opacity="0.8" />
                                        </Border>
                                    </Grid>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1"
                                               Text="{x:Bind Description, Mode=OneWay}"
                                               Style="{StaticResource BodyTextStyle}"
                                               TextWrapping="Wrap" />

                                    <!-- Affected Entity -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Affected Record:" FontWeight="SemiBold" Opacity="0.75" />
                                        <TextBlock Text="{x:Bind AffectedEntity, Mode=OneWay}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Technical Details / Reason -->
                                    <StackPanel Grid.Row="3"
                                                Spacing="4"
                                                Visibility="{x:Bind HasTechnicalDetails, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Reason / Details:" FontWeight="SemiBold" Opacity="0.75" />
                                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                CornerRadius="4"
                                                Padding="10,6">
                                            <TextBlock Text="{x:Bind TechnicalDetails, Mode=OneWay}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Recommended Action -->
                                    <StackPanel Grid.Row="4"
                                                Spacing="4"
                                                Visibility="{x:Bind HasRecoveryHint, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Recommended Action:" FontWeight="SemiBold" Opacity="0.75" />
                                        <TextBlock Text="{x:Bind RecoveryHint, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- Safe Repair Action Button -->
                                    <StackPanel Grid.Row="5"
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                Margin="0,6,0,0"
                                                Visibility="{x:Bind IsRepairable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Button Content="Repair Issue"
                                                Command="{x:Bind RepairCommand, Mode=OneWay}"
                                                Style="{StaticResource PrimaryButtonStyle}" />
                                        <ProgressRing IsActive="{x:Bind IsRepairing, Mode=OneWay}"
                                                      Visibility="{x:Bind IsRepairing, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      Width="20" Height="20" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>

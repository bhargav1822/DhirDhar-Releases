{
    "Application": {
        "Name": "DhirDhar Solution",
        "Version": "2.1.3",
        "Environment": "Production"
    },
    "Database": {
        "Provider": "Sqlite",
        "DatabasePath": "DhirDhar.db",
        "CommandTimeout": 30,
        "EnableSensitiveDataLogging": false
    },
    "Backup": {
        "Enabled": true,
        "Provider": "Local",
        "Directory": "",
        "AutomaticBackupEnabled": true,
        "BackupFrequency": "Daily",
        "RetentionCount": 7,
        "GoogleDriveEnabled": false,
        "GoogleDriveFolder": "DhirDhar/Backups",
        "GoogleDriveClientId": "",
        "GoogleDriveClientSecret": "",
        "EncryptBackups": true
    },
    "Security": {
        "DataProtectionEnabled": true
    },
    "Logging": {
        "MinimumLevel": "Information"
    },
    "Localization": {
        "DefaultCulture": "en-US"
    },
    "Update": {
        "GitHubRepository": "bhargav1822/DhirDhar-Releases",
        "IncludePrerelease": false,
        "AutoCheckEnabled": true,
        "AutoInstallEnabled": true
    }
}
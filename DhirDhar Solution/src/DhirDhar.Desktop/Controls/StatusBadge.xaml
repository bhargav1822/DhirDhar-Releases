<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DhirDhar.Desktop.Controls.StatusBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="8,4">
        <Border CornerRadius="12" Background="{x:Bind ColorBrush, Mode=OneWay}" Opacity="0.15" />
        <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="12" FontWeight="SemiBold" Foreground="{x:Bind ColorBrush, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>

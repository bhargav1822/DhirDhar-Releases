    <SkipType name="DhirDhar.Infrastructure.Persistence.*" />
    <SkipType name="DhirDhar.Infrastructure.Configuration.*" />
    <SkipType name="DhirDhar.Infrastructure.DependencyInjection.*" />
    <SkipType name="DhirDhar.Infrastructure.Security.Integrity.*" />
  </Module>

</Obfuscator>

<?xml version="1.0" encoding="utf-8"?>
<Obfuscator>
  <Var name="InPath" value="d:\DhirDhar\DhirDhar Solution\Release" />
  <Var name="OutPath" value="d:\DhirDhar\DhirDhar Solution\Release_Obfuscated" />

  <!-- Hardening Options -->
  <Var name="KeepPublicApi" value="true" />
  <Var name="HidePrivateApi" value="true" />
  <Var name="RenameFields" value="false" />
  <Var name="RenameProperties" value="false" />
  <Var name="RenameEvents" value="false" />
  <Var name="RenameMethods" value="false" />
  <Var name="RenameParameters" value="false" />
  <Var name="HideStrings" value="true" />
  <Var name="OptimizeMethods" value="true" />
  <Var name="SuppressIldasm" value="true" />
  <Var name="AnalyzeLogFile" value="obfuscar_analysis.log" />

  <!-- Target Sensitive Assemblies for String Encryption & Anti-Tamper Hardening -->
  <Module file="$(InPath)\DhirDhar.Infrastructure.dll">
